{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "teamdee-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "wordpress",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@wp-playground/cli@3.1.60",
        "server",
        "--port=9400",
        "--php=8.3",
        "--mount-before-install=./wordpress-local:/wordpress",
        "--wordpress-install-mode=install-from-existing-files-if-needed",
        "--mount=./wp-theme/teamdee:/wordpress/wp-content/themes/teamdee",
        "--blueprint=./wp-theme/blueprint.json",
        "--login"
      ],
      "port": 9400
    },
    {
      "name": "teamdee-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}