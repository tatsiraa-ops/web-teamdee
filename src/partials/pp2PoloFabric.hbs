{{!-- Fabric and price comparison. Prices and quantity bands come from prices.json;
     fabric specifications and colour codes come from polo.json. Without JS every panel remains available. --}}
{{#with pp2.poloFabric}}
<section class="pf2" id="fabric" aria-labelledby="pf2-h" data-pf2>
  <div class="wrap">
    <header class="pf2__head">
      <h2 id="pf2-h">{{{hl h accent}}}</h2>
      <p>{{{ph p}}}</p>
    </header>
    <ul class="pf5__terms" aria-label="เงื่อนไขราคาเสื้อโปโลปัก">
      <li><img src="/img/icons/team-shirts.webp" width="140" height="140" alt="" loading="lazy" decoding="async"><div><strong>เริ่มสั่ง {{minQty}} ตัว</strong></div></li>
      <li><img src="/img/icons/benefit-size.webp" width="140" height="140" alt="" loading="lazy" decoding="async"><div><strong>ทุกไซซ์ราคาเดียว</strong></div></li>
      <li><img src="/img/icons/dz-logo.webp" width="140" height="140" alt="" loading="lazy" decoding="async"><div><strong>รวมปักโลโก้ที่อก</strong><span>1 จุด · รวม VAT แล้ว</span></div></li>
      <li><img src="/img/icons/talk-quote.webp" width="140" height="140" alt="" loading="lazy" decoding="async"><div><strong>ปักเพิ่มจุดได้</strong><span>แจ้งราคาตอนประเมินงาน</span></div></li>
    </ul>
    <div class="pf4 pf5">
        {{#each fabrics}}
        <article class="pf4__panel pf5__card" id="fab-{{this.id}}" aria-labelledby="fabn-{{this.id}}" data-fab="{{this.id}}" data-name="{{this.name}}">
          <figure class="pf4__hero">
            <img src="{{this.hero}}" width="1120" height="648" alt="เนื้อ{{this.name}} ({{this.en}}) ระยะใกล้" loading="lazy" decoding="async">
            <figcaption><span lang="en">{{this.en}}</span><h3 id="fabn-{{this.id}}">{{this.name}}</h3><p>{{this.tagline}}</p><small>~{{this.gsm}} แกรม · {{this.feel}}</small></figcaption>
          </figure>
          <div class="pf4__body">
            <div class="pf5__info"><p class="pf5__composition">{{#if this.comp}}{{this.comp}}{{else}}เนื้อผ้า สอบถามทีมงาน{{/if}}</p>
            <div class="pf5__uses"><p>เหมาะกับ</p><ul style="--use-count:{{this.useTags.length}}">{{#each this.useTags}}<li><img src="{{this.icon}}" width="112" height="112" alt="" loading="lazy" decoding="async"><span>{{this.label}}</span></li>{{/each}}</ul></div>
            <p class="pf4__tip">{{this.note}}</p></div>
            <div class="pf5__prices">
              <table><caption>ราคาต่อตัว {{this.name}} <span>บาท · รวม VAT</span></caption><thead><tr>{{#each this.prices}}<th scope="col">{{this.label}}<span>ตัว</span></th>{{/each}}</tr></thead><tbody><tr>{{#each this.prices}}<td>{{this.price}}</td>{{/each}}</tr></tbody></table>
            </div>
            <div class="pf2__colors">
              <details class="pf5__color-picker">
                <summary><span class="pf5__palette" aria-hidden="true">{{#each this.main}}<i style="--swatch:{{this.hex}}"></i>{{/each}}</span><span class="pf5__color-label"><span class="pf5__color-show">ดูสีผ้า</span><span class="pf5__color-hide">ซ่อนสีผ้า</span><small>{{this.colors.length}} สีให้เลือก</small></span><span class="pf5__color-chevron" aria-hidden="true"></span></summary>
              <ul class="pf2__sw" aria-label="สี{{this.name}}">{{#each this.main}}<li><button type="button" class="pf2__c" style="--c:{{this.hex}}" data-code="{{this.code}}" aria-pressed="false"><span class="pf2__dot" aria-hidden="true"></span><span class="pf2__code">{{this.code}}</span></button></li>{{/each}}{{#each this.base}}<li><button type="button" class="pf2__c pf2__c--base" style="--c:{{this.hex}}" data-code="{{this.code}}" aria-pressed="false"><span class="pf2__dot" aria-hidden="true"></span><span class="pf2__code">{{this.code}}</span></button></li>{{/each}}</ul>
              {{#if this.base.length}}<p class="pf4__base"><i aria-hidden="true"></i> วงที่มีขีดใต้ = โทนพื้นฐาน</p>{{/if}}
                <p class="pf5__color-note">สีจริงอาจต่างจากจอเล็กน้อย</p>
              </details>
              <p class="pf2__picked" data-picked aria-live="polite"></p>
              <div class="pf5__actions"><a class="pf4__quote" href="{{@root.priceAsk}}" data-quote data-track="line" data-where="pp-price-board"><span data-quote-label>ขอใบเสนอราคาทาง LINE</span><span aria-hidden="true">↗</span></a>
              <div class="pf4__ask"><a class="pp-more pf2__ask" href="{{this.ask}}" data-ask data-track="line" data-where="pp-fabric" aria-label="ขอตัวอย่าง{{this.name}}ฟรี">ขอตัวอย่างผ้า <span aria-hidden="true">→</span></a><small>ฟรี ไม่ต้องวางมัดจำ</small></div></div>
            </div>
          </div>
        </article>
        {{/each}}
    </div>
  </div>
</section>
{{/with}}
