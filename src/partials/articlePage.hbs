{{#unless articleDraft}}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"{{item.title}}","description":"{{item.excerpt}}","image":"{{site.baseUrl}}{{item.img}}","publisher":{"@type":"Organization","name":"TEAMDEE","legalName":"บริษัท ดีดี ฟินิกซ์ จำกัด"},"mainEntityOfPage":"{{site.baseUrl}}{{articleHref}}"}</script>{{/unless}}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"บทความและไอเดีย","item":"{{site.baseUrl}}{{url 'blog'}}"},{"@type":"ListItem","position":3,"name":"{{item.title}}"}]}</script>

<div class="td-reader">
<header class="wrap td-reader__header">
  <div>
    <nav class="td-reader__crumb" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><a href="{{url 'blog'}}">บทความและไอเดีย</a><span aria-hidden="true">/</span><span aria-current="page">{{item.title}}</span></nav>
    {{#unless wp}}{{#if articleDraft}}<p class="pending-ribbon">ร่างบทความสำหรับตรวจเนื้อหา · ยังไม่เปิดให้เครื่องมือค้นหาเก็บข้อมูล</p>{{/if}}{{/unless}}
    <h1 class="td-reader__title">{{item.title}}</h1>
    <p class="td-reader__meta"><span>{{item.catName}}</span>{{#unless articleDraft}}{{#if item.updated}}<span>อัปเดต {{item.updated}}</span>{{/if}}{{/unless}}</p>
  </div>
</header>

<section class="wrap td-reader__reading">
  <div class="td-reader__layout">
    <aside class="td-reader__toc">
      <details open>
        <summary>ในบทความนี้</summary>
        <nav aria-label="สารบัญบทความ" data-reader-toc>
          <ol>{{#each item.sections}}<li><a href="#{{this.id}}">{{this.t}}</a></li>{{/each}}</ol>
        </nav>
      </details>
      <a class="td-reader__back" href="{{url 'blog'}}">กลับไปเลือกบทความ</a>
    </aside>

    <!-- 2 · เนื้อหา · คำตอบหลักอยู่ตั้งแต่ต้น -->
    <article class="td-reader__body" data-reader-content>
      <p class="td-reader__lead">{{item.lead}}</p>

      <figure class="td-reader__cover">
        <div>
          {{!-- กรอบ 16:9 ล็อกใน article-reader.css (30 ต.ค. H20 CLS) · data-sizes = ขนาดจริงให้ตัวเติม srcset ตอน build (ถ้ามีไฟล์ย่อ) --}}
          <img src="{{item.img}}" alt="{{item.title}}" width="1200" height="675" data-sizes="(min-width:820px) 760px, calc(100vw - 40px)" fetchpriority="high" decoding="async" class="w-full h-full object-cover">
        </div>
      </figure>

      {{!-- คลิปประกอบบทความ (videos.json places articles.<id> · แนวทาง ค 26 ต.ค.) --}}
      {{#if vids.length}}<ul class="vgrid mt-9" aria-label="คลิปประกอบ">{{#each vids}}<li>{{> videoSlot v=this wp=@root.wp}}{{#if this.caseHref}}<a class="pp-more" href="{{this.caseHref}}">อ่านเรื่องของ{{this.customer}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/if}}</li>{{/each}}</ul>{{/if}}

      {{#each item.sections}}
      <section class="art-sec scroll-mt-28 mt-11" id="{{this.id}}">
        <h2 class="t-display text-[clamp(24px,3vw,34px)]">{{this.t}}</h2>
        <p class="t-body mt-4">{{this.body}}</p>
        {{#if this.list}}
        <ul class="mt-5 space-y-3">
          {{#each this.list}}
          <li class="flex gap-3 text-[17px] leading-[1.75] text-ink-2"><svg class="shrink-0 mt-2 text-orange" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}
        {{#if this.table}}
        <div class="overflow-x-auto border-2 border-ink rounded-card mt-6" tabindex="0" role="region" aria-label="ตารางเปรียบเทียบ เลื่อนซ้ายขวาได้">
          {{!-- มือถือเรียงเป็นการ์ดทีละแถว · ตารางเทียบ 2 อย่างต้องเห็นทั้งสองฝั่ง (audit 26 ต.ค.) --}}
          <table class="rtable w-full sm:min-w-[520px] text-[17px]">
            <thead class="bg-ink text-paper"><tr>{{#each this.table.head}}<th scope="col" class="text-left font-bold px-5 py-4">{{this}}</th>{{/each}}</tr></thead>
            <tbody>{{#each this.table.rows}}<tr class="border-t border-line">{{#each this}}{{#if @first}}<th scope="row" class="text-left font-bold px-5 py-4">{{this}}</th>{{else}}<td class="px-5 py-4 text-ink-2" data-label="{{lookup ../../table.head @index}}">{{this}}</td>{{/if}}{{/each}}</tr>{{/each}}</tbody>
          </table>
        </div>
        {{/if}}
        {{#if this.links}}<p class="mt-5 flex flex-wrap gap-x-6">{{#each this.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}</p>{{/if}}
      </section>
      {{/each}}

      {{#if more}}
      <section class="mt-11" aria-labelledby="more-h" data-reader-exclude>
        <h2 id="more-h" class="t-display text-[clamp(22px,2.6vw,30px)]">{{more.h}}</h2>
        <p class="mt-4 flex flex-wrap gap-x-6">{{#each more.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}</p>
      </section>
      {{/if}}

      <section class="td-reader__context" aria-label="อ่านต่อและปรึกษา" data-reader-exclude>
        <h2>อ่านต่อตามบริบท</h2>
        <ul>{{#each item.links}}<li><a href="{{url this.[1]}}">{{this.[0]}}</a></li>{{/each}}</ul>
        <a class="btn btn-orange btn-sm" href="{{url 'contact'}}?from=blog">ปรึกษาทีมดี</a>
      </section>
      <div class="td-reader__note">
        <p class="t-sm">บทความนี้เป็นข้อมูลประกอบการตัดสินใจ เงื่อนไขที่ผูกพันจริงอยู่ในใบเสนอราคาของแต่ละงาน</p>
      </div>
    </article>

  </div>
</section>

<!-- 3 · บทความเกี่ยวข้อง -->
{{#if related.length}}
<section class="td-reader__related">
  <div class="wrap section">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <h2 class="t-display text-[clamp(24px,3vw,36px)]">{{#if relatedH}}{{relatedH}}{{else}}บทความเกี่ยวข้อง{{/if}}</h2>
      <a class="inline-flex items-center min-h-[44px] font-bold text-ink underline decoration-orange decoration-2 underline-offset-4 hover:decoration-ink" href="{{url 'blog'}}">ดูบทความทั้งหมด<span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="td-reader__related-grid">
      {{#each related}}
      <a href="{{#if this.to}}{{url this.to}}{{else}}{{url 'articles' this.id}}{{/if}}" class="td-reader__card">
        <img src="{{this.img}}" alt="{{this.title}}" width="600" height="300" loading="lazy" decoding="async" class="td-reader__card-image">
        <h3 class="td-reader__card-title">{{this.title}}</h3>
        <p class="td-reader__card-excerpt">{{this.excerpt}}</p>
        <p class="td-reader__card-meta">{{this.catName}}</p>
      </a>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}

<section class="td-reader__end" aria-labelledby="end-h">
  <div class="wrap">
    <h2 id="end-h">{{#if cta}}{{cta.h}}{{else}}มีคำถามที่บทความยังไม่ได้ตอบ{{/if}}</h2>
    <p>{{#if cta}}{{cta.p}}{{else}}ถามทีมดีได้โดยตรง ไม่ต้องมีแบบ ไม่ต้องรู้ชื่อเสื้อ{{/if}}</p>
    <div class="td-reader__actions"><a class="btn btn-orange gap-2" href="{{@root.pageLine}}" data-track="line"><span class="block size-5" aria-hidden="true">{{> icoChat}}</span>ทัก LINE ขอราคา</a><a class="btn btn-line" href="{{url 'contact'}}?from=blog">ฝากข้อมูลให้ติดต่อกลับ</a></div>
    <p class="td-reader__meta"><a class="tabular-nums" href="tel:{{site.phonePrimaryTel}}">โทร {{site.phonePrimary}}</a><span>{{{ph site.hours}}}</span></p>
  </div>
</section>
</div>
