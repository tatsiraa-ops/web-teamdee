{{!-- /sublimation/ คำถามก่อนสั่ง · รอบ 139 (บอร์ด "faq") · ชิ้น FAQ หน้าแรกทั้งชิ้นแบบเดียวกับ /corporate/ (up2Faq.hbs · CSS #faq ใน home.css)
     คำถาม-คำตอบเดิมของหน้า (product-pages.json print.faq · JSON-LD เดิม) · ไอคอนตามความหมาย (pp-v2.json print.faq.icons) · 7 ข้อ + กล่องถามทีม = 8 ช่อง
     ท้าย: เช็กคิวตามวันใช้เสื้อ (LINE) + วางแผนวันรับและการจัดส่ง · แทน ppFaq --}}
<section class="wrap hm-sec hm-reference hm-faq pp2-faq" id="faq" aria-labelledby="faq-h">
<header class="hm-faq__head"><h2 id="faq-h">{{{hl pp.faq.h pp2.faq.accent}}}</h2><a class="hm-faq__all" href="{{url 'faq'}}">ดูคำถามทั้งหมด <span aria-hidden="true">↗</span></a></header>
<div class="hm-faq__group"><div class="hm-faq__grid">{{#each pp.faq.items}}<details name="pp-faq"><summary><img class="hm-faq__art" src="/img/icons/{{lookup ../pp2.faq.icons @index}}.webp" alt="" width="176" height="176" loading="lazy" decoding="async"><span class="hm-faq__q">{{{ph this.[0]}}}</span><span class="hm-faq__ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path class="hm-faq__v" d="M12 5v14"/></svg></span></summary><p>{{{ph this.[1]}}}</p></details>{{/each}}<div class="hm-faq__help"><img class="hm-faq__art" src="/img/icons/faq-ask.webp" alt="" width="176" height="176" loading="lazy" decoding="async"><div class="hm-faq__htx"><p class="hm-faq__ht">ไม่เจอคำตอบที่หา?</p><p class="hm-faq__hp">พิมพ์ถามในแชท แนบรูปเสื้อได้</p></div><a class="cb cb--p cb--2l hm-faq__cta" href="{{@root.faqCtaLine}}" data-track="line" data-where="pp-faq"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__lbl"><span class="cb__t">{{@root.faqCta.cta}}</span><span class="cb__sub" data-float-status><span class="cb__dot" aria-hidden="true"></span><span data-float-status-t>{{@root.site.hours}}</span></span></span><svg width="24" height="24" class="cb__arw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div></div>
<p class="pp2-faq__more"><a href="{{ppNextLine.queue}}" data-track="line" data-where="pp-faq-queue">เช็กคิวตามวันใช้เสื้อ <span aria-hidden="true">↗</span></a>{{#each pp.faq.links}}<a href="{{url this.to}}">{{this.t}} <span aria-hidden="true">→</span></a>{{/each}}</p>
</section>
