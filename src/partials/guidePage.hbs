<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"คู่มือและบทความ"},{"@type":"ListItem","position":3,"name":"{{item.name}}"}]}</script>

<!-- หัวคู่มือ -->
<section class="band-ink relative overflow-hidden">
  <span class="absolute inset-x-0 top-0 h-1 bg-orange z-10" aria-hidden="true"></span>
  <div class="wrap relative py-12 md:py-16">
    <nav class="crumb2" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>คู่มือและบทความ</span><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <h1 class="t-display text-[clamp(30px,4.4vw,54px)] text-paper mt-7 max-w-[20ch]">{{item.name}}</h1>
    <p class="text-[18px] leading-[1.75] text-paper/70 max-w-[56ch] mt-4">สำหรับ {{item.who}}</p>
    <p class="text-[15px] text-paper/60 mt-3">อัปเดต {{item.updated}}</p>
    {{#if item.hidden}}
    <p class="mt-6 inline-block border-2 border-orange rounded-card px-4 py-3 text-[16px] font-semibold text-paper">หน้านี้รองรับไว้ ยังไม่เปิดในเมนูและยังไม่ให้ Google เก็บ · เปิดเมื่อบริการพร้อม [รอยืนยัน]</p>
    {{/if}}
    <p class="text-[18px] leading-[1.8] text-paper/80 max-w-[60ch] mt-5">{{item.intro}}</p>

    <div class="flex flex-wrap items-center gap-2.5 mt-8 pt-6 border-t border-paper/20">
      <span class="text-[15px] font-semibold text-paper/55 mr-1">ในคู่มือนี้แยกไว้ว่าใครทำอะไร</span>
      <span class="gtag gtag--customer">ลูกค้าส่ง</span>
      <span class="gtag gtag--teamdee">ทีมดีทำ</span>
      <span class="gtag gtag--approve">ต้องอนุมัติ</span>
    </div>
  </div>
</section>

<section class="wrap section">
  <div class="grid lg:grid-cols-[250px_minmax(0,1fr)] gap-10 lg:gap-16 items-start">

    <!-- สารบัญ ติดซ้าย -->
    <nav class="lg:sticky lg:top-28" aria-labelledby="toc-h" id="guideToc">
      <h2 id="toc-h" class="text-[15px] font-bold text-ink-3 mb-3">สารบัญ</h2>
      <ol class="toc">
        {{#each item.sections}}
        <li><a href="#{{this.id}}"><span class="tabular-nums text-ink-3 mr-2">{{this.no}}</span>{{this.title}}</a></li>
        {{/each}}
      </ol>
      <p class="t-xs mt-5 max-w-[30ch]">ทุกหัวข้อมีลิงก์ของตัวเอง กดที่หัวข้อแล้วคัดลอกลิงก์ส่งต่อเฉพาะส่วนได้</p>
    </nav>

    <!-- เนื้อหา -->
    <div class="max-w-[68ch]">
      {{#each item.sections}}
      <article class="guide-sec scroll-mt-28 {{#unless @first}}mt-14 pt-14 border-t border-line{{/unless}}" id="{{this.id}}">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="t-display text-[clamp(24px,3vw,34px)]"><span class="text-ink-3 tabular-nums mr-2">{{this.no}}</span>{{this.title}}</h2>
          {{#if this.tag}}
          <span class="gtag gtag--{{this.tag}}">{{#if (eq this.tag 'customer')}}ลูกค้าส่ง{{/if}}{{#if (eq this.tag 'teamdee')}}ทีมดีทำ{{/if}}{{#if (eq this.tag 'approve')}}ต้องอนุมัติ{{/if}}</span>
          {{/if}}
        </div>

        {{#if this.body}}<p class="t-body mt-4">{{this.body}}</p>{{/if}}

        {{#if (eq this.kind 'steps')}}
        <ol class="mt-6 border-t-2 border-ink">
          {{#each this.items}}
          <li class="why-row">
            <span class="why-row__no">0{{inc @index}}</span>
            <div class="why-row__body col-span-2">
              <span class="gtag gtag--{{this.tag}} mb-2">{{#if (eq this.tag 'customer')}}ลูกค้าส่ง{{/if}}{{#if (eq this.tag 'teamdee')}}ทีมดีทำ{{/if}}{{#if (eq this.tag 'approve')}}ต้องอนุมัติ{{/if}}</span>
              <h3 class="why-row__t">{{this.t}}</h3>
              <p class="why-row__d">{{this.d}}</p>
            </div>
          </li>
          {{/each}}
        </ol>
        {{/if}}

        {{#if this.list}}
        <ul class="mt-5 space-y-3">
          {{#each this.list}}
          <li class="flex gap-3 text-[17px] leading-[1.75] text-ink-2"><svg class="shrink-0 mt-2 text-orange" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if (eq this.kind 'collars')}}
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
          {{#each this.items}}
          <li class="border border-line rounded-card p-4 text-center">
            <span class="block text-ink mx-auto w-full max-w-[120px]">{{> (lookup this 'icon')}}</span>
            <span class="block font-bold text-[17px] mt-2">{{this.t}}</span>
            {{#if this.d}}<span class="block t-xs mt-1">{{this.d}}</span>{{/if}}
          </li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if (eq this.kind 'table')}}
        <div class="overflow-x-auto border-2 border-ink rounded-card mt-6">
          <table class="w-full min-w-[560px] text-[17px]">
            <thead class="bg-ink text-paper"><tr>{{#each this.head}}<th scope="col" class="text-left font-bold px-5 py-4">{{this}}</th>{{/each}}</tr></thead>
            <tbody>
              {{#each this.rows}}
              <tr class="border-t border-line">{{#each this}}{{#if @first}}<th scope="row" class="text-left font-bold px-5 py-4">{{this}}</th>{{else}}<td class="px-5 py-4 text-ink-2">{{this}}</td>{{/if}}{{/each}}</tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <p class="scroll-hint">ปัดตารางไปทางขวาเพื่อดูคอลัมน์ที่เหลือ</p>
        {{/if}}

        {{#if (eq this.kind 'sizes')}}
        <div class="overflow-x-auto border-2 border-ink rounded-card mt-6">
          <table class="w-full min-w-[460px] text-[17px]">
            <caption class="text-left font-bold text-[18px] px-5 py-4 border-b-2 border-ink">หน่วยเป็น{{@root.sizing.unit}} วัดจากตัวเสื้อวางราบ</caption>
            <thead class="bg-ink text-paper"><tr>
              <th scope="col" class="text-left font-bold px-5 py-4">ไซซ์</th>
              <th scope="col" class="text-right font-bold px-5 py-4">รอบอก</th>
              <th scope="col" class="text-right font-bold px-5 py-4">ความยาว</th>
              <th scope="col" class="text-right font-bold px-5 py-4">ไหล่</th>
            </tr></thead>
            <tbody>
              {{#each @root.sizing.sizes}}
              <tr class="border-t border-line"><th scope="row" class="text-left font-bold px-5 py-3.5">{{this.size}}</th><td class="px-5 py-3.5 text-right tabular-nums">{{this.chest}}</td><td class="px-5 py-3.5 text-right tabular-nums">{{this.length}}</td><td class="px-5 py-3.5 text-right tabular-nums">{{this.shoulder}}</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <p class="scroll-hint">ปัดตารางไปทางขวาเพื่อดูคอลัมน์ที่เหลือ</p>
        <p class="t-xs mt-3">{{@root.sizing.tolerance}}</p>
        {{/if}}

        {{#if (eq this.kind 'fabrics')}}
        <ul class="divide-y divide-line border-t-2 border-ink mt-6">
          {{#each @root.sizing.fabrics}}
          <li class="flex items-baseline justify-between gap-6 py-4">
            <span class="text-[18px] font-bold">{{this.name}}</span>
            <span class="t-sm text-right max-w-[30ch]">{{this.use}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if (eq this.kind 'props')}}
        <div class="grid sm:grid-cols-2 gap-5 mt-6">
          {{#each @root.sizing.fabricProps}}
          <div class="bg-shell border border-line rounded-plate p-6">
            <p class="text-[15px] font-bold tracking-[0.12em] text-ink-3">{{this.en}}</p>
            <h3 class="text-[19px] font-bold mt-1.5">{{this.th}}</h3>
            <p class="t-sm mt-2">{{this.d}}</p>
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if (eq this.kind 'download')}}
        <a class="btn btn-orange btn-lg mt-6 gap-2 whitespace-normal text-center max-w-full" href="{{this.file}}" download>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
          {{this.label}}
        </a>
        <p class="t-xs mt-3">เปิดด้วย Excel หรือ Google Sheets ได้ กรอกแล้วส่งกลับมาไฟล์เดียว</p>
        {{/if}}

        {{#if (eq this.kind 'faq')}}
        <div class="hs-accordion-group border-t-2 border-ink mt-6">
          {{#each this.items}}
          <div class="hs-accordion border-b border-line" id="gfaq-{{@../index}}-{{@index}}">
            <button type="button" class="hs-accordion-toggle w-full flex items-start justify-between gap-5 text-left py-5 min-h-tap font-bold text-[18px] hover:underline decoration-orange decoration-2 underline-offset-4" aria-controls="gfaq-panel-{{@../index}}-{{@index}}">
              <span>{{this.[0]}}</span>
              <svg class="shrink-0 mt-1.5 transition-transform hs-accordion-active:rotate-45 text-orange" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <div id="gfaq-panel-{{@../index}}-{{@index}}" class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300" role="region">
              <p class="t-body pb-6">{{this.[1]}}</p>
            </div>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </article>
      {{/each}}

      <!-- คู่มือเล่มอื่น -->
      <div class="mt-14 pt-10 border-t-2 border-ink">
        <h2 class="t-display text-[clamp(22px,2.6vw,30px)]">คู่มือเล่มอื่น</h2>
        <div class="chiprail mt-5">
          {{#each otherGuides}}<a class="chip" href="{{url 'guides' this.id}}">{{this.name}}</a>{{/each}}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONVERT -->
<section class="band-orange">
  <div class="wrap py-14 md:py-20 text-center">
    <h2 class="t-display text-[clamp(28px,4vw,48px)] text-ink">ติดตรงไหน ถามทีมดีได้เลย</h2>
    <p class="text-[18px] leading-[1.75] text-ink/85 max-w-[46ch] mx-auto mt-4">ส่งเท่าที่มี ไม่ต้องครบก็เริ่มได้</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a class="btn btn-lg bg-paper text-ink border-paper hover:bg-ink hover:text-paper hover:border-ink gap-2" href="{{site.lineUrl}}" data-track="line"><span class="block size-5">{{> icoChat}}</span>ทักไลน์</a>
      <a class="btn btn-lg bg-transparent text-ink border-ink/60 hover:bg-ink hover:text-paper hover:border-ink" href="{{url 'contact'}}">กรอกฟอร์ม</a>
    </div>
  </div>
</section>
