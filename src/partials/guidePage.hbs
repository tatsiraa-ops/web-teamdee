<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"คู่มือและบทความ","item":"{{site.baseUrl}}{{url 'blog'}}"},{"@type":"ListItem","position":3,"name":"{{item.name}}"}]}</script>
<div class="td-guide td-guide--{{item.id}}">
  {{!-- hero เดียว (ตรวจหน้าคู่มือ 27 ต.ค.): พื้น shell แบบหน้าแบบเสื้อ/รีวิว/FAQ · คำถามลัด 3 ข้อพาไปหัวข้อ (guide-presentation.js quickLinks)
       ปุ่ม "เลือกคู่มือเรื่องอื่น" ด้านบนเอาออก ซ้ำกับรายการคู่มือท้ายหน้าและเมนู --}}
  <header class="td-guide__header"><div class="wrap">
    <nav class="crumb2" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><a href="{{url 'blog'}}">คู่มือและบทความ</a><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <h1 class="t-display td-guide__h1">{{#if item.h1}}{{{ph item.h1}}}{{else}}{{{ph item.name}}}{{/if}}</h1>
    {{#if item.lead}}<p class="td-guide__lead">{{item.lead}}</p>{{/if}}
    <p class="td-guide__meta"><span>{{item.sections.length}} หัวข้อ</span><span aria-hidden="true">·</span><span>อัปเดต {{item.updated}}</span></p>
    {{#if item.hidden}}<p class="td-guide__notice">หน้านี้เป็นต้นแบบที่ยังไม่เปิดเผยแพร่ ข้อมูลบางส่วนรอยืนยัน</p>{{/if}}
    {{#if item.quickLinks.length}}<ul class="td-guide__quick" aria-label="คำถามที่คู่มือนี้ตอบ">{{#each item.quickLinks}}<li style="--i:{{@index}}"><a href="#{{this.id}}"><span>{{this.label}}</span><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a></li>{{/each}}</ul>{{/if}}
  </div></header>
  <div class="wrap td-guide__experience">
    {{> guideMaterialLab}}
    {{> guideProcessStudio}}
  </div>
  {{!-- สารบัญติดใต้หัวเว็บชุดเดียวกับหน้ารู้จักทีมดี/หน้าสินค้า (ไฮไลต์หัวข้อที่อ่าน + แถบอ่านถึงไหน · เดิมเม็ดยาดำ top 76px ตายตัว) --}}
  <nav class="ab-toc td-guide__abtoc" aria-label="สารบัญคู่มือ" id="guideToc" data-toc>
    <div class="wrap ab-toc__in">{{#each item.sections}}<a href="#{{this.id}}">{{this.title}}</a>{{/each}}</div>
    <span class="ab-toc__bar" aria-hidden="true"></span>
  </nav>
  <div class="wrap td-guide__layout">
    <div class="td-guide__body">
      <div class="td-guide__context"><p>{{item.intro}}</p><p class="td-guide__who">สำหรับ {{item.who}}</p></div>
      {{#each item.sections}}
      <section class="guide-sec td-guide__section" id="{{this.id}}" aria-labelledby="guide-heading-{{this.id}}">
        <div class="td-guide__section-side"><div class="td-guide__section-head"><h2 id="guide-heading-{{this.id}}" tabindex="-1">{{this.title}}</h2>{{#if this.tag}}<span class="gtag gtag--{{this.tag}}">{{#if (eq this.tag 'customer')}}ลูกค้าส่ง{{/if}}{{#if (eq this.tag 'teamdee')}}ทีมดีทำ{{/if}}{{#if (eq this.tag 'approve')}}ต้องอนุมัติ{{/if}}</span>{{/if}}</div>
        <div class="td-guide__share"><button type="button" class="td-guide__copy" data-guide-copy="{{this.id}}" hidden aria-label="คัดลอกลิงก์หัวข้อ {{this.title}}" title="คัดลอกลิงก์หัวข้อนี้"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg><span>คัดลอกลิงก์</span></button><span data-guide-copy-status role="status" aria-live="polite"></span></div>
        </div><div class="td-guide__section-content">
        {{> guideBlock this blockHeading="h3"}}
        {{#each this.parts}}<section class="td-guide__part" aria-labelledby="{{../id}}-p{{@index}}" id="{{../id}}-{{this.id}}"><div class="td-guide__part-head"><h3 id="{{../id}}-p{{@index}}">{{this.title}}</h3>{{#if this.tag}}<span class="gtag gtag--{{this.tag}}">{{#if (eq this.tag 'customer')}}ลูกค้าส่ง{{/if}}{{#if (eq this.tag 'teamdee')}}ทีมดีทำ{{/if}}{{#if (eq this.tag 'approve')}}ต้องอนุมัติ{{/if}}</span>{{/if}}</div>{{> guideBlock this blockHeading="h4"}}</section>{{/each}}
        {{!-- เก็บไซซ์ทั้งทีม: เฉพาะหน้าที่ส่ง roster=true (/size-chart/) ในหัวข้อ collect · audit มือถือ 30 ต.ค. ข้อ 36 --}}
        {{#if ../roster}}{{#if (eq this.id 'collect')}}{{> rosterTool}}{{/if}}{{/if}}
        {{#if (eq this.id @root.guideCta.next.section)}}{{> ppNext ico=@root.guideCta.next.ico t=@root.guideCta.next.t p=@root.guideCta.next.p href=@root.guideCta.next.line label=@root.guideCta.next.label where="guide-next"}}{{/if}}
        </div>
      </section>
      {{/each}}
    </div>
  </div>
  <section class="td-guide__library wrap" aria-labelledby="guide-library-h" id="guide-library"><div><h2 id="guide-library-h">คู่มือที่ใช้ต่อได้</h2><p>เลือกอ่านเฉพาะเรื่องที่ทีมคุณกำลังเตรียม</p></div><nav aria-label="เลือกอ่านคู่มือ"><ul>{{#each item.guideNav}}<li><a href="{{url 'guides' this.id}}"{{#if this.current}} aria-current="page"{{/if}}><span>{{this.label}}</span>{{#if this.current}}<small>กำลังอ่าน</small>{{else}}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>{{/if}}</a></li>{{/each}}</ul></nav></section>
  {{!-- แชทตามเรื่องของคู่มือ (vite guideCta · ไฟล์/รูปแนบตามบริบท) --}}
  {{> ctaBox id="guide-cta" tone="no" c=guideCta.c href=guideCta.line where="cta-guide" cta=guideCta.cta href2=(url 'contact') q2="?from=guide" cta2="ฝากข้อมูลให้ติดต่อกลับ"}}
</div>
