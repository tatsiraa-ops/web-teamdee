{{!-- ติดต่อ โฉมใหม่ (อาร์ต 3 พ.ย. ส่วน "contact" ของโครง · กติกา: ดึงจากหน้าแรกทั้ง component) · การ์ด "พบทีมดีได้ที่นนทบุรี" ของหน้าแรก (คัดจาก homeReference-teamdee-location.hbs)
     อาร์ต "ลบ": หัวข้อทีมดี ไทม์ไลน์ ภาพ และการ์ดบริษัท ออก เหลือการ์ดพบทีมดี (หัวข้อเป็น H2 แทน) · ป้ายติดตาม LINE use-* · div.td-page-home = ขอบเขต CSS หน้าแรก --}}
<div class="td-page-home up2-home">
<section class="wrap hm-sec hm-reference hm-origin" id="story" aria-labelledby="up2-visit-h">
  {{!-- กล่องพบทีมดี · รื้อ 3 พ.ย. 2026 (อาร์ต "ทำมาใหม่ เต็มที่ สุดๆ") · โทนขาวส้มบนพื้นสตูดิโอ แทนกล่องดำ
       ขวา: ไดโอรามา 3D (Magnific GPT 2.5 high สไตล์ชุด CI · ไม่ใช่รูปออฟฟิศจริง) กดแล้วเปิด Google Maps
       ซ้าย: 3 แถวข้อมูลพร้อมไอคอน 3D · ที่อยู่/เบอร์จาก site.json · ปุ่ม LINE นัดเข้าพบ + โทร --}}
  <div class="hm-visit">
    <div class="hm-visit__copy">
      <h2 class="hm-visit__h" id="up2-visit-h">{{{hl "พบทีมดีได้ที่นนทบุรี" "นนทบุรี"}}}</h2>
      <ul class="hm-visit__rows">
        <li class="hm-visit__row"><img src="/img/icons/visit-pin.webp" alt="" width="160" height="160" loading="lazy" decoding="async"><div><span class="hm-visit__k">สำนักงานใหญ่ / ออฟฟิศเข้าพบ</span><span class="hm-visit__v">{{{ph site.address}}}</span></div></li>
        <li class="hm-visit__row"><img src="/img/icons/visit-clock.webp" alt="" width="160" height="160" loading="lazy" decoding="async"><div><span class="hm-visit__k">ติดต่อทุกวัน</span><span class="hm-visit__v">08:30–21:00 น. · LINE @teamdee</span></div></li>
        <li class="hm-visit__row"><img src="/img/icons/visit-booked.webp" alt="" width="160" height="160" loading="lazy" decoding="async"><div><span class="hm-visit__k">เข้าพบที่ออฟฟิศ</span><span class="hm-visit__v">นัดหมายก่อนเข้าพบ</span></div></li>
      </ul>
      <div class="hm-visit__actions"><a class="cb cb--p hm-line-cta" href="{{@root.pageLine}}" data-track="line" data-where="use-teamdee-location"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__t">ทัก LINE นัดเข้าพบ</span></a><a class="hm-visit__tel" href="tel:{{site.phonePrimaryTel}}"><img src="/img/icons/visit-phone.webp" alt="" width="160" height="160" loading="lazy" decoding="async">โทร {{site.phonePrimary}}</a></div>
    </div>
    <a class="hm-visit__map" href="{{site.mapUrl}}" target="_blank" rel="noopener" aria-label="เปิดที่อยู่ออฟฟิศทีมดีใน Google Maps (แท็บใหม่)">
      <img class="hm-visit__art" src="/img/visit/diorama-1200.webp" srcset="/img/visit/diorama-720.webp 720w, /img/visit/diorama-1200.webp 1200w" sizes="(min-width:1100px) 520px, 80vw" alt="" width="1200" height="1126" loading="lazy" decoding="async">
            <span class="hm-visit__maplink">เปิดใน Google Maps <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</section>
</div>
