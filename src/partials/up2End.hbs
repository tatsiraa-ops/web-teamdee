{{!-- ปิดหน้า โฉมใหม่ รอบ 4 (อาร์ต 3 พ.ย. "ชอบแบบเดิม แต่ทำให้เหมือนเสื้อหลายตัวกำลังฟุ้งออกมาจาก footer") · ส่วนปิดเดิมทุกตัวอักษร (hm-end)
     + พื้นหลังคลีนเจนเฉพาะ (อาร์ต "พื้นหลังคลีนๆ เจนมา เฟี้ยวๆ" · Magnific GPT 2.5 high · แสงส้มพุ่งจากขอบล่าง บนครึ่งบนขาวโล่ง) + เสื้อ 3D 7 ตัวพุ่งเป็นพัดจากขอบล่าง (ตัวกลางสูงสุด ตัวริมเอียงออก) ครึ่งล่างถูกขอบส่วนตัด เหมือนออกมาจาก footer · ลอยขึ้นลงเบาๆ · ลดการเคลื่อนไหว = นิ่ง --}}
<section class="hm-end up2-end" aria-labelledby="end-h">
  <svg class="hm-end__arc" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 300C300 90 620 20 760 20c240 0 480 70 680 200v80z"/></svg>
  <div class="wrap relative hm-end__in">
    <p class="hm-eyebrow is-en"><span lang="en">WE BUILD TEAM IDENTITY</span></p>
    <h2 id="end-h">เล่าโจทย์ของทีมคุณมา</h2>
    <p class="hm-end__lead">บอกว่าใครใส่ จำนวนประมาณ และใช้วันไหน ยังไม่มีแบบก็เริ่มได้</p>
    <div class="hm-cta__btns hm-end__btns"><a class="cb cb--p" href="{{up.team.ask.line}}" data-track="line" data-where="use-end"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__t">{{up.team.ask.t}}</span></a><a class="btn btn-line btn-lg tabular-nums" href="{{cta.secondary.href}}">{{cta.secondary.label}}</a></div>
    {{#if (eq cta.mode 'line')}}<p class="hm-end__alt"><a class="tabular-nums" href="{{cta.tel.href}}">โทร {{cta.tel.label}}</a><span class="hm-end__sep" aria-hidden="true">·</span><span>{{{ph site.hours}}}</span>{{#if cta.docs}}<span class="hm-end__sep" aria-hidden="true">·</span><span>ขอเอกสารจัดซื้อได้ ใบเสนอราคา ใบกำกับภาษี</span>{{/if}}</p>{{else}}<p class="hm-end__alt">ขอเอกสารจัดซื้อได้ ใบเสนอราคา ใบกำกับภาษี<span class="hm-end__sep" aria-hidden="true">·</span><span>{{{ph site.hours}}}</span></p>{{/if}}
  </div>
  {{!-- เสื้อฟุ้งออกมาจาก footer (อาร์ต 3 พ.ย.) · เสื้อ 3D แบบจริงของทีมดี (jersey3d / sport3d พื้นใส · ไม่ซ้ำแบบในโชว์รูมหน้านี้) · ตกแต่งล้วน aria-hidden --}}
  <img class="up2-end__bg" src="/img/use-end/burst-1440.webp" srcset="/img/use-end/burst-800.webp 800w, /img/use-end/burst-1440.webp 1440w, /img/use-end/burst-2304.webp 2304w" sizes="100vw" alt="" width="2304" height="987" loading="lazy" decoding="async">
  <div class="up2-burst" aria-hidden="true"><img class="up2-burst__s is-1" src="/img/jersey3d/watsadu-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-2" src="/img/sport3d/navy-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-3" src="/img/jersey3d/highvolt-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-4" src="/img/jersey3d/ptk-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-5" src="/img/jersey3d/choomthong-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-6" src="/img/sport3d/red-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"><img class="up2-burst__s is-7" src="/img/jersey3d/school50-front-440.webp" alt="" width="440" height="540" loading="lazy" decoding="async"></div>
</section>
