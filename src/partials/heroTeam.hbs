{{!-- hero หน้าแรก · สไลด์แบนเนอร์ (3 พ.ย. 2026)
     ภาพไม่มีตัวหนังสือ (Magnific GPT 2.5 high · อาร์ตเลือก 2 ภาพ) + ข้อความ HTML ทับฝั่งซ้าย ในกรอบกลางที่อาร์ตวาด (~11–88% ของความกว้าง)
     อาร์ต: "ข้อความ ฟอนต์ เดะเราเอามาใส่เอง" → แก้คำที่ home.json hero.slides ได้เลย ไม่ต้องสร้างภาพใหม่
     H1 (คำค้นหลัก) คงที่เป็น sr-only · บรรทัดเปิดของสไลด์กีฬา = H2 ของ v22 · สลับเองด้วย src/js/hero-sets.js (กดจุด/ลูกศร/ปัดได้ · เมาส์ชี้ไม่หยุด · หยุดเมื่อโฟกัสคีย์บอร์ด/พ้นจอ/ลดการเคลื่อนไหว) --}}
<section class="th th--slides" data-hero-team data-hero-sets aria-labelledby="th-h1">
  <div class="wrap">
    <h1 id="th-h1" class="sr-only">รับทำเสื้อทีม เสื้อบริษัท พร้อมโลโก้</h1>
    <div class="th-sets th-reel">
      {{#each homeV4.hero.slides}}
      <div class="th-slide{{#if @first}} is-warm{{else}} is-off{{/if}}" id="th-set-{{this.id}}" role="tabpanel" aria-labelledby="th-tab-{{this.id}}" data-set-panel{{#unless @first}} inert{{/unless}}>
        <picture class="th-pic"><source media="(max-width: 767px)" srcset="{{this.mobileSmall}} 480w, {{this.mobile}} 768w" sizes="100vw" width="768" height="1024"><img class="th-front th-slide__img" src="{{this.small}}" srcset="{{this.small}} 1280w, {{this.img}} 2304w" sizes="100vw" width="2304" height="800" alt="{{this.alt}}" draggable="false"{{#if @first}} fetchpriority="high"{{else}} loading="lazy"{{/if}} decoding="async"></picture>
        <div class="th-copy-o">
          {{#if @first}}<p class="th-o__kick" aria-hidden="true">{{this.kick}}</p>{{else}}<h2 class="th-o__kick">{{this.kick}}</h2>{{/if}}
          <p class="th-o__h"><span class="inline-block">{{{ph this.l1}}}</span> <span class="th-o__accent">{{{ph this.l2}}}</span></p>
          <p class="th-o__sub">{{{ph this.sub}}}</p>
          <a class="cb cb--p cb--2l th-o__cta" href="{{@root.pageLine}}" data-track="line" data-where="hero"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__lbl"><span class="cb__t">{{@root.homeV4.hero.cta}}</span><span class="cb__sub" data-float-status><span class="cb__dot" aria-hidden="true"></span><span data-float-status-t>{{@root.site.hours}}</span></span></span><svg width="24" height="24" class="cb__arw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      {{/each}}
    </div>
    {{!-- ลูกศรก่อนหน้า/ถัดไป (อาร์ต 3 พ.ย. "เอาแบบกดเลื่อนได้") · ลากหรือปัดบนภาพก็ได้ (hero-sets.js) --}}
    <button type="button" class="th-nav th-nav--prev" data-set-prev aria-label="แบนเนอร์ก่อนหน้า"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
    <button type="button" class="th-nav th-nav--next" data-set-next aria-label="แบนเนอร์ถัดไป"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    <div class="th-ctrl">
      <div class="th-tabs th-dots" role="tablist" aria-label="เลือกแบนเนอร์">
        {{#each homeV4.hero.slides}}
        <button type="button" role="tab" id="th-tab-{{this.id}}" aria-controls="th-set-{{this.id}}" aria-selected="{{#if @first}}true{{else}}false{{/if}}" tabindex="{{#if @first}}0{{else}}-1{{/if}}" data-set-tab="{{this.id}}" aria-label="แบนเนอร์ {{inc @index}}: {{this.label}}"><span class="th-tab__bar" aria-hidden="true"></span></button>
        {{/each}}
      </div>
    </div>
  </div>
</section>
