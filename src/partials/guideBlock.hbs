{{!-- Shared guide blocks. Parent passes blockHeading="h4" beneath H3 subsections. --}}
{{#if this.body}}<p class="gblock-body">{{this.body}}</p>{{/if}}
{{#if (eq this.kind 'steps')}}
<ol class="gblock-steps">{{#each this.items}}
  <li class="gblock-step"><span class="gblock-step__number" aria-hidden="true">{{inc @index}}</span><div>
    <div class="gblock-step__heading">{{#if (eq ../blockHeading 'h4')}}<h4 class="gblock-title">{{this.t}}</h4>{{else}}<h3 class="gblock-title">{{this.t}}</h3>{{/if}}
    {{#if this.tag}}<span class="gblock-role">{{#if (eq this.tag 'customer')}}ลูกค้าส่ง{{/if}}{{#if (eq this.tag 'teamdee')}}ทีมดีทำ{{/if}}{{#if (eq this.tag 'approve')}}ต้องอนุมัติ{{/if}}</span>{{/if}}</div>
    <p class="gblock-description">{{this.d}}</p>
  </div></li>{{/each}}
</ol>{{/if}}
{{#if this.list}}<ul class="gblock-list">{{#each this.list}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
{{#if (eq this.kind 'collars')}}
<ul class="gblock-collars">{{#each this.items}}<li><span class="gblock-collars__drawing" aria-hidden="true">{{> (lookup this 'icon')}}</span><strong>{{this.t}}</strong>{{#if this.d}}<p class="gblock-description">{{this.d}}</p>{{/if}}</li>{{/each}}</ul>
{{/if}}
{{#if (eq this.kind 'table')}}
<p class="gblock-table-hint">เปรียบเทียบรายละเอียดในตาราง · เลื่อนซ้าย–ขวาเพื่อดูครบทุกคอลัมน์</p>
<div class="gblock-table-scroll" tabindex="0" role="region" aria-label="ตาราง {{this.title}} เลื่อนซ้ายขวาได้">
  <table class="gblock-table"><caption class="sr-only">{{this.title}}</caption><thead><tr>{{#each this.head}}<th scope="col">{{this}}</th>{{/each}}</tr></thead>
    <tbody>{{#each this.rows}}<tr>{{#each this}}{{#if @first}}<th scope="row">{{this}}</th>{{else}}<td>{{this}}</td>{{/if}}{{/each}}</tr>{{/each}}</tbody>
  </table>
</div>{{/if}}
{{#if (eq this.kind 'sizes')}}
{{#if @root.sizeDraftHidden}}<p class="gblock-caution">ทักแอดมินเพื่อขอตารางไซซ์ล่าสุดของสินค้าและทรงที่เลือกก่อนสรุปจำนวน</p><a class="btn btn--ghost mt-4" href="/contact-us/?from=size-chart">ขอตารางไซซ์จากทีมดี →</a>{{else}}
<p class="gblock-caution">ตารางนี้เป็นขนาดอ้างอิงเบื้องต้น กรุณายืนยันตารางไซซ์ของสินค้าและทรงที่เลือกกับทีมดีก่อนสรุปจำนวน</p>
<div class="gblock-table-scroll" tabindex="0" role="region" aria-label="ตารางไซซ์เสื้อ">
  <table class="gblock-table gblock-table--sizes"><caption>หน่วยเป็น{{@root.sizing.unit}} วัดจากตัวเสื้อวางราบ</caption>
    <thead><tr><th scope="col">ไซซ์</th><th scope="col">รอบอก</th><th scope="col">ความยาว</th><th scope="col">ไหล่</th></tr></thead>
    <tbody>{{#each @root.sizing.sizes}}<tr><th scope="row">{{this.size}}</th><td>{{this.chest}}</td><td>{{this.length}}</td><td>{{this.shoulder}}</td></tr>{{/each}}</tbody>
  </table>
</div><p class="gblock-note">{{@root.sizing.tolerance}} · เป็นข้อมูลอ้างอิง กรุณายืนยันค่าคลาดเคลื่อนของงานที่สั่งกับทีมดีอีกครั้ง</p>{{/if}}{{/if}}
{{#if (eq this.kind 'fabrics')}}
<ul class="gblock-cards">{{#each @root.sizing.fabrics}}<li class="gblock-card">
  <img class="gblock-card__image" src="{{this.img}}" alt="ผิว{{this.name}}ระยะใกล้" width="1200" height="558" loading="lazy" decoding="async">
  {{#if (eq ../blockHeading 'h4')}}<h4 class="gblock-title">{{this.name}}</h4>{{else}}<h3 class="gblock-title">{{this.name}}</h3>{{/if}}<p class="gblock-description">{{this.use}}</p>
</li>{{/each}}</ul>{{/if}}
{{#if (eq this.kind 'props')}}
<dl class="gblock-properties">{{#each @root.sizing.fabricProps}}<div><dt>{{this.th}} <span lang="en">{{this.en}}</span></dt><dd>{{this.d}}</dd></div>{{/each}}</dl>
{{/if}}
{{#if (eq this.kind 'download')}}
<div class="gblock-download"><a class="cb cb--s gblock-download__button" href="{{this.file}}" download><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>{{this.label}}</a>
  <p class="gblock-note">เปิดด้วย Excel หรือ Google Sheets ได้ กรอกแล้วส่งกลับมาไฟล์เดียว</p>
  <p class="gblock-note">ก่อนกรอกจำนวน กรุณายืนยันตารางไซซ์ของสินค้าและทรงที่เลือกกับทีมดี ไม่ใช้ขนาดอ้างอิงแทนสเปกงานจริง</p>
</div>{{/if}}
{{#if (eq this.kind 'faq')}}
{{!-- การ์ดกางได้ชุดเดียวกับหน้า /faq/ และหน้าสินค้า (.fq-q · main.css) --}}<div class="gblock-faq fq-list">{{#each this.items}}<details class="fq-q" id="gfaq-{{../id}}-{{@index}}">
  <summary><span class="fq-q__t">{{this.[0]}}</span><span class="fq-q__pm"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path class="fq-q__v" d="M12 5v14"/><path d="M5 12h14"/></svg></span></summary>
  <div class="fq-q__a" id="gfaq-panel-{{../id}}-{{@index}}"><p>{{this.[1]}}</p></div>
</details>{{/each}}</div>{{/if}}
{{#if (eq this.kind 'cards')}}
<ul class="gblock-cards">{{#each this.cards}}<li class="gblock-card">
  {{#if this.img}}<img src="{{this.img}}" alt="ผิว{{this.t}}ระยะใกล้" width="1200" height="558" loading="lazy" decoding="async" class="gblock-card__image">{{/if}}
  {{#if this.ph}}{{#unless @root.wp}}<span class="img-pending gblock-card__placeholder">{{this.ph}}</span>{{/unless}}{{/if}}
  {{#if (eq ../blockHeading 'h4')}}<h4 class="gblock-title">{{this.t}}</h4>{{else}}<h3 class="gblock-title">{{this.t}}</h3>{{/if}}{{#if this.d}}<p class="gblock-description">{{this.d}}</p>{{/if}}
</li>{{/each}}</ul>{{/if}}
{{#if (eq this.kind 'links')}}
<ul class="gblock-links">{{#each this.links}}<li><a href="{{url this.to}}">{{this.t}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a></li>{{/each}}</ul>
{{/if}}
