{{!-- hero หน้าสินค้าโฉมใหม่ (อาร์ต 5 พ.ย. บอร์ด "หน้าบริการ : รับผลิตเสื้อพิมพ์ลาย" · src/data/pp-v2.json) · การวางเท่าแบนเนอร์หน้าแรกและหน้า /corporate/ (up2Hero.hbs)
     ภาพ 2304×800 ไม่มีตัวหนังสือ · มือถือภาพ 3:4 ข้อความกลางซ้อนบนส่วนจาง · H1 คำหลักดำ + บรรทัดส้ม · ปุ่ม LINE สองบรรทัด data-where="pp-hero" --}}
<section class="band-hero pp2-hero" aria-labelledby="pp2-h1">
  <div class="pp2-hero__reel">
    <picture class="pp2-hero__pic"><source media="(max-width: 767px)" srcset="{{pp2.hero.mobileSmall}} 480w, {{pp2.hero.mobile}} 768w" sizes="100vw" width="768" height="1024"><img class="pp2-hero__img" src="{{pp2.hero.small}}" srcset="{{pp2.hero.tiny}} 800w, {{pp2.hero.small}} 1280w, {{pp2.hero.img}} 2304w" sizes="100vw" width="2304" height="800" alt="{{pp2.hero.alt}}" fetchpriority="high" decoding="async"></picture>
    <nav class="crumb2 pp2-hero__crumb" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>สินค้าและบริการ</span><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <div class="pp2-hero__copy">
      <p class="th-o__kick">{{pp2.hero.kicker}}</p>
      <h1 id="pp2-h1" class="th-o__h"><span class="inline-block">{{{ph pp2.hero.h1main}}}</span><span class="sr-only"> </span><span class="th-o__accent">{{{ph pp2.hero.h1rest}}}</span></h1>
      <p class="th-o__sub">{{pp.hero.lead}}</p>
      <a class="cb cb--p cb--2l th-o__cta" href="{{priceAsk}}" data-track="line" data-where="pp-hero"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__lbl"><span class="cb__t">ทัก LINE ขอราคา</span><span class="cb__sub" data-float-status><span class="cb__dot" aria-hidden="true"></span><span data-float-status-t>{{site.hours}}</span></span></span><svg width="24" height="24" class="cb__arw" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
