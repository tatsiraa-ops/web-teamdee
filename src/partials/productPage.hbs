{{!-- หน้าสินค้า 6 หน้า ตาม Wireframe v22 (22 ต.ค. 2026) · 14 ส่วนเรียงตาม v22
     ข้อความ: src/data/product-pages.json (สร้างจาก wireframe ด้วย scripts/v22/product-pages.mjs)
     ข้อมูลจริงที่มีอยู่แล้วมาแทนช่อง [วงเล็บ] ของ v22: แบบเสื้อรหัส TD · ผ้า · สเปกทรง/คอ/ออปชั่น · ตารางไซซ์ · ผลงาน
     src/js/product-view.js ตัดข้อความที่ยังรอยืนยันออกบนเว็บจริง · ต้นแบบโชว์พร้อมป้าย --}}
{{#if productLd}}<script type="application/ld+json">{{{productLd}}}</script>
{{/if}}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"{{item.name}}"}]}</script>

<!-- 01 · hero -->
<section class="band-hero relative overflow-hidden">
  <span class="absolute inset-x-0 top-0 h-1 bg-orange z-10" aria-hidden="true"></span>
  <div class="wrap relative py-12 md:py-18">
    <nav class="crumb2" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>สินค้าและบริการ</span><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center mt-8">
      <div>
        <h1 class="t-display text-[clamp(32px,4.6vw,56px)] text-ink">{{pp.hero.h1}}</h1>
        <p class="text-[19px] leading-[1.75] text-ink-2 max-w-[52ch] mt-5">{{pp.hero.lead}}</p>
        {{#if item.seoLine}}<p class="text-[17px] leading-[1.7] text-ink-2 max-w-[56ch] mt-3">{{item.seoLine}}</p>{{/if}}
        {{#if pp.hero.facts.length}}
        <dl class="flex flex-wrap gap-x-8 gap-y-3 mt-8 border-t border-line pt-6">
          {{#each pp.hero.facts}}<div><dt class="text-[15px] font-semibold text-ink-3">{{this.k}}</dt><dd class="text-[17px] font-bold text-ink-2 mt-1">{{this.v}}</dd></div>{{/each}}
        </dl>
        {{/if}}
        <div class="flex flex-wrap gap-3 mt-9">
          <a class="btn btn-orange btn-lg max-sm:whitespace-normal max-sm:text-center max-sm:py-3" href="{{url 'contact'}}?p={{item.id}}">{{pp.hero.cta}}</a>
          <a class="btn btn-lg bg-transparent text-ink border-ink/40 hover:bg-ink hover:text-ink hover:border-ink" href="#options">ดูแบบและตัวเลือก</a>
        </div>
      </div>
      <figure class="relative">
        <div class="overflow-hidden rounded-plate bg-paper aspect-[3/2]">
          {{#if item.img}}<img src="{{item.img}}" alt="{{item.name}} ด้านหน้าและด้านหลัง แบบที่ทีมดีผลิต" width="1080" height="720" fetchpriority="high" decoding="async" class="w-full h-full object-contain">
          {{else}}<span class="prod-noimg" role="img" aria-label="ยังไม่มีภาพ{{item.name}}"><span class="block size-14">{{> icoShirt}}</span><span>{{item.name}}</span></span>{{/if}}
        </div>
        {{#if item.img}}<figcaption class="tag {{#unless (eq item.imgKind 'real')}}tag-ink{{/unless}} absolute left-4 top-4 max-w-[calc(100%-2rem)]">{{#if (eq item.imgKind 'real')}}งานผลิตจริง{{else}}ภาพจำลอง{{/if}}</figcaption>{{/if}}
      </figure>
    </div>
  </div>
</section>

{{#if pp.toc.length}}
<nav class="border-b border-line bg-paper" aria-label="ข้ามไปยังหัวข้อในหน้านี้">
  <div class="wrap chiprail py-3">
    {{#each pp.toc}}<a class="chip" href="#{{this.key}}">{{this.t}}</a>{{/each}}
  </div>
</nav>
{{/if}}

<!-- 02 · แบบและตัวเลือก -->
<section class="wrap section" id="options">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div class="max-w-[62ch]">
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoShirt}}</span>แบบและตัวเลือก</span>
      <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.options.h}}</h2>
      {{#each pp.options.intro}}<p class="t-lead mt-4">{{this}}</p>{{/each}}
    </div>
    {{#each pp.options.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
  </div>

  <ol class="grid md:grid-cols-3 gap-4">
    {{#each pp.options.cards}}
    <li class="pp-card"><span class="pp-card__no">{{inc @index}}</span><h3 class="text-[20px] mt-3">{{this.h}}</h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}</li>
    {{/each}}
  </ol>

  {{#if pp.options.specTabs.length}}
  <div class="spec-tabs mt-10" data-tabs>
    <h3 class="text-[19px] mb-4">ตัวเลือกที่ผลิตได้</h3>
    <div class="chiprail" role="tablist" aria-label="ตัวเลือกที่ผลิตได้">
      {{#each pp.options.specTabs}}<button class="spec-tab" role="tab" type="button" id="t-{{this.id}}" aria-controls="p-{{this.id}}" aria-selected="{{#if @first}}true{{else}}false{{/if}}"{{#unless @first}} tabindex="-1"{{/unless}}>{{this.t}}</button>{{/each}}
    </div>
    {{#each pp.options.specTabs}}
    <div role="tabpanel" id="p-{{this.id}}" aria-labelledby="t-{{this.id}}" tabindex="0" class="mt-5 overflow-x-auto border-2 border-ink rounded-card max-w-[860px]"{{#unless @first}} hidden{{/unless}}>
      <table class="w-full min-w-[320px] text-[17px]">
        <thead class="bg-ink text-paper"><tr><th scope="col" class="text-left font-bold px-5 py-4">ตัวเลือก</th><th scope="col" class="text-left font-bold px-5 py-4">หมายเหตุ</th></tr></thead>
        <tbody>{{#each (lookup ../pp.options.spec this.id)}}<tr class="border-t border-line"><th scope="row" class="text-left font-bold px-5 py-4">{{this.[0]}}</th><td class="px-5 py-4 text-ink-2">{{this.[1]}}</td></tr>{{/each}}</tbody>
      </table>
    </div>
    {{/each}}
    <p class="t-xs mt-3"><a class="font-semibold text-ink underline decoration-orange decoration-2 underline-offset-4" href="{{url 'guides' 'collar'}}">คู่มือทรงคอ · เลือกคอให้เหมาะกับงาน</a></p>
  </div>
  {{/if}}

  {{#if productDesigns.length}}
  <div class="mt-14" id="ex">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <h3 class="t-display text-[clamp(22px,2.6vw,30px)]">เลือกกราฟิกพร้อมรหัสแบบ กดขยายแล้วเซฟไปคุยต่อ</h3>
      <a class="pp-more" href="{{url 'designs'}}?product={{item.id}}" id="prodAll">ดูแบบ{{item.name}}ทั้งหมด<span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
    {{#if productTags.length}}
    <div class="chiprail mb-6" id="prodTags" data-show="6">
      <span class="text-[15px] font-bold mr-1">ทรงเสื้อ</span>
      <button class="chip" type="button" data-tag="all" aria-pressed="true">ทั้งหมด <span class="tabular-nums opacity-60">{{productDesigns.length}}</span></button>
      {{#each productTags}}<button class="chip" type="button" data-tag="{{this.garment}}" data-q="{{this.name}}" aria-pressed="false">{{this.name}} <span class="tabular-nums opacity-60">{{this.n}}</span></button>{{/each}}
    </div>
    <p class="t-sm tabular-nums -mt-2 mb-6" id="prodCount" role="status">แสดง 6 จาก {{productDesigns.length}} แบบ · ดูครบในแกลเลอรี</p>
    {{/if}}
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3" id="prodGrid" data-line-url="{{site.lineUrl}}">
      {{#each productDesigns}}
      <figure class="overflow-hidden rounded-card bg-paper border border-line aspect-[3/2]" data-code="{{this.code}}" data-meta="{{this.meta}}" data-garment="{{this.garment}}"{{#unless (lt @index 6)}} hidden{{/unless}}>
        <img src="{{this.img}}" srcset="{{this.imgSmall}} 540w, {{this.img}} 1080w" sizes="(min-width:1024px) 33vw, 50vw" width="1080" height="720" loading="lazy" decoding="async" alt="แบบ{{this.garmentName}} รหัส {{this.code}} ด้านหน้าและด้านหลัง" class="w-full h-full object-contain">
      </figure>
      {{/each}}
    </div>
  </div>
  {{/if}}
</section>

<!-- 03 · ผ้า -->
{{#if pp.fabric.show}}
<section class="bg-shell border-y border-line" id="fabric">
  <div class="wrap section">
    <div class="max-w-[62ch] mb-8">
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoCube}}</span>ผ้า</span>
      <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.fabric.h}}</h2>
      {{#each pp.fabric.intro}}<p class="t-lead mt-4">{{this}}</p>{{/each}}
    </div>
    {{#if pp.fabric.fabrics.length}}
    <ul class="pp-fabrics">
      {{#each pp.fabric.fabrics}}
      <li>{{#if this.img}}<img src="{{this.img}}" alt="ผิว{{this.name}}ระยะใกล้" width="120" height="120" loading="lazy" decoding="async">{{else}}<span class="pp-fabrics__no" aria-hidden="true"></span>{{/if}}<div><h3 class="text-[18px]">{{this.name}}</h3><p class="t-sm mt-1">{{this.use}}</p></div></li>
      {{/each}}
    </ul>
    {{/if}}
    {{#unless wp}}{{#if pp.fabric.table}}<p class="pending-ribbon mt-6">ตารางสเปกผ้าของ v22 รอข้อมูลจริง (ส่วนผสม / น้ำหนัก) · บนเว็บจริงซ่อนไว้</p>{{/if}}{{/unless}}
    {{#each pp.fabric.notes}}<p class="t-sm mt-5">{{this}}</p>{{/each}}
    <div class="flex flex-wrap gap-3 mt-7">
      <a class="btn btn-line" href="{{url 'contact'}}?p={{item.id}}&amp;from=fabric">ขอดูตัวอย่างผ้า</a>
      {{#each pp.fabric.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
    </div>
  </div>
</section>
{{/if}}

<!-- 04 · รายละเอียดงาน (ปัก / ลาย / สกรีน / ซิป ฯลฯ) -->
{{#if pp.detail.show}}
<section class="wrap section" id="detail">
  <div class="max-w-[62ch] mb-8">
    <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoSpark}}</span>รายละเอียดงาน</span>
    <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.detail.h}}</h2>
    {{#each pp.detail.intro}}<p class="t-lead mt-4">{{this}}</p>{{/each}}
  </div>
  <ol class="grid md:grid-cols-3 gap-4">
    {{#each pp.detail.cards}}<li class="pp-card"><span class="pp-card__no">{{inc @index}}</span><h3 class="text-[20px] mt-3">{{this.h}}</h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}</li>{{/each}}
  </ol>
  {{#if pp.detail.table}}
  <div class="overflow-x-auto border-2 border-ink rounded-card mt-8 max-w-[860px]" tabindex="0" role="region" aria-label="ตารางรายละเอียด เลื่อนซ้ายขวาได้">
    <table class="w-full min-w-[320px] text-[17px]">
      <thead class="bg-ink text-paper"><tr>{{#each pp.detail.table.head}}<th scope="col" class="text-left font-bold px-5 py-4">{{this}}</th>{{/each}}</tr></thead>
      <tbody>{{#each pp.detail.table.rows}}<tr class="border-t border-line"><th scope="row" class="text-left font-bold px-5 py-4">{{this.[0]}}</th><td class="px-5 py-4 text-ink-2">{{this.[1]}}</td></tr>{{/each}}</tbody>
    </table>
  </div>
  {{/if}}
  {{#each pp.detail.links}}<a class="pp-more mt-6" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
</section>
{{/if}}

<!-- 05 · ราคา -->
{{#if pp.price.show}}
<section class="bg-shell border-y border-line" id="price">
  <div class="wrap section grid lg:grid-cols-[1fr_1fr] gap-10 lg:gap-16 items-start">
    <div>
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoTag}}</span>ราคา</span>
      <h2 class="t-display text-[clamp(28px,3.6vw,44px)]">{{pp.price.h}}</h2>
      {{#if pp.price.factors.length}}
      <h3 class="text-[19px] mt-7">{{pp.price.factorsTitle}}</h3>
      <ul class="mt-3 space-y-2.5">{{#each pp.price.factors}}<li class="pp-dot">{{this}}</li>{{/each}}</ul>
      {{/if}}
      {{#if pp.price.need}}
      <h3 class="text-[19px] mt-7">{{pp.price.need.h}}</h3>
      <ul class="mt-3 space-y-2.5">{{#each pp.price.need.items}}<li class="pp-dot">{{this}}</li>{{/each}}</ul>
      {{/if}}
      <p class="t-xs mt-6 max-w-[44ch]">ราคายืนยันอยู่ในใบเสนอราคา · <a class="font-semibold text-ink underline decoration-orange decoration-2 underline-offset-4" href="{{url 'calculations'}}">คำนวณราคาเบื้องต้น</a></p>
    </div>
    <div>
      {{#if pp.price.box}}
      <div class="pbox">{{#if pp.price.box.amount}}<p class="pbox__k">ราคาเริ่มต้น</p><p class="pbox__v"><span class="pbox__n">{{pp.price.box.amount}}</span> <span class="pbox__u">{{pp.price.box.unit}}</span></p>{{else}}<p class="text-[22px] font-bold">{{pp.price.box.strong}}</p>{{/if}}<p class="pbox__p">{{{ph pp.price.box.p}}}</p><p class="pbox__s">{{{ph pp.price.box.small}}}</p></div>
      {{/if}}
      {{#unless pp.price.confirmed}}
      <div class="bg-paper border-2 border-ink rounded-plate p-7 {{#if pp.price.box}}mt-5{{/if}}">
        <p class="text-[22px] font-bold">ขอราคาตามแบบและจำนวนของทีมคุณ</p>
        <p class="t-body mt-2">ส่งรหัสแบบหรือภาพอ้างอิง จำนวนคร่าว ๆ และวันที่ต้องใช้ ทีมดีแจ้งราคาต่อตัวให้ ออกแบบฟรี ขั้นต่ำ 10 ตัว</p>
        <a class="btn btn-orange mt-5 gap-2" href="{{priceAsk}}"><span class="block size-5">{{> icoChat}}</span>ขอราคาทางไลน์</a>
        {{#unless wp}}<p class="pending-ribbon mt-4">รอตารางราคาจากทีม (แบบเดียวกับโปโลปักและเบสบอลใน prices.json) · ได้แล้วกล่องนี้หายเอง ตารางราคาขึ้นแทน</p>{{/unless}}
      </div>
      {{/unless}}
      {{#if pp.price.table}}
      {{!-- ตารางราคาแบบใบเสนอราคา: เส้นบาง หัวเทาตัวเล็ก ตัวเลขชิดขวาหนา (อาร์ต 23 ต.ค.: แบบกรอบดำหนา "ดูเด็กเล่น") --}}
      <div class="ptable mt-5" tabindex="0" role="region" aria-label="ตารางราคาต่อตัว">
        <table>
          <caption>ราคาต่อตัว (บาท) · รวม VAT 7%</caption>
          <thead><tr>{{#each pp.price.table.head}}<th scope="col">{{{ph this}}}</th>{{/each}}</tr></thead>
          <tbody>{{#each pp.price.table.rows}}<tr>{{#each this}}{{#if @first}}<th scope="row">{{this}}</th>{{else}}<td>{{this}}</td>{{/if}}{{/each}}</tr>{{/each}}</tbody>
        </table>
      </div>
      {{#if (lt 3 pp.price.table.head.length)}}<p class="t-xs mt-2 md:hidden">ปัดตารางไปทางซ้ายเพื่อดูผ้าอื่น</p>{{/if}}
      {{/if}}
      {{#each pp.price.notes}}<p class="t-sm mt-4">{{{ph this}}}</p>{{/each}}
    </div>
  </div>
</section>
{{/if}}

<!-- 06 · ชวนขอราคา -->
<section class="band-soft">
  <div class="wrap py-12 md:py-14 flex flex-wrap items-center justify-between gap-6">
    <div class="max-w-[56ch]"><h2 class="t-display text-[clamp(24px,3vw,34px)] text-ink">{{pp.quote.h}}</h2><p class="text-[17px] leading-[1.7] text-ink-2 mt-2">{{pp.quote.p}}</p></div>
    <a class="btn btn-orange btn-lg max-sm:whitespace-normal max-sm:text-center max-sm:py-3" href="{{url 'contact'}}?p={{item.id}}">{{pp.quote.cta}}</a>
  </div>
</section>

<!-- 07 · เบื้องหลังการผลิต -->
{{#if pp.production.show}}
<section class="wrap section" id="production">
  <div class="max-w-[62ch] mb-8">
    <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoPrinter}}</span>การผลิต</span>
    <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.production.h}}</h2>
  </div>
  <div class="grid {{#if productionPhoto}}lg:grid-cols-[1.2fr_0.8fr]{{/if}} gap-10 items-start">
  <ol class="mt-2 border-t-2 border-ink max-w-[860px]">
    {{#each pp.production.cards}}<li class="why-row"><span class="why-row__no">0{{inc @index}}</span><div class="why-row__body"><h3 class="why-row__t">{{this.h}}</h3>{{#each this.p}}<p class="why-row__d">{{this}}</p>{{/each}}</div></li>{{/each}}
  </ol>
  {{#if productionPhoto}}<figure><div class="overflow-hidden rounded-plate bg-shell aspect-[3/4] max-w-[420px]"><img src="{{productionPhoto.img}}" alt="{{productionPhoto.alt}}" width="900" height="1200" loading="lazy" decoding="async" class="w-full h-full object-cover"></div><figcaption class="t-sm mt-3">{{productionPhoto.cap}}</figcaption></figure>{{/if}}
  </div>
  {{#unless productionPhoto}}{{#unless wp}}<p class="pending-ribbon mt-6">รอภาพขั้นตอนผลิตจริงของสินค้านี้ · ข้อความด้านบนขึ้นเว็บจริงได้ ภาพยังไม่มี</p>{{/unless}}{{/unless}}
  {{#each pp.production.notes}}<p class="t-sm mt-3">{{this}}</p>{{/each}}
</section>
{{/if}}

<!-- 08 · ผลงานจริง -->
{{#if pp.work.show}}
<section class="bg-shell border-y border-line" id="work">
  <div class="wrap section">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div class="max-w-[62ch]">
        <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoUsers}}</span>เสื้อจริง</span>
        <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.work.h}}</h2>
      </div>
      <a class="pp-more" href="{{url 'projects'}}">ดูผลงานและรีวิวทั้งหมด<span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
    {{#if pp.work.real.length}}
    <div class="grid md:grid-cols-3 gap-5">
      {{#each pp.work.real}}
      <article class="bg-paper border border-line rounded-plate overflow-hidden flex flex-col">
        <div class="relative aspect-[4/3] bg-shell">
          <img src="{{this.img}}" alt="ทีมใส่{{this.title}}จริง" width="600" height="450" loading="lazy" decoding="async" class="w-full h-full object-cover">
          <span class="tag tag-ink absolute left-3 bottom-3">งานผลิตจริง</span>
        </div>
        <div class="p-6 on-paper grow">
          <p class="t-xs">{{this.groupName}}</p>
          <h3 class="text-[19px] mt-1">{{this.title}}</h3>
          <dl class="mt-3 space-y-2 text-[16px] leading-[1.6]">
            <div><dt class="inline font-bold">โจทย์ </dt><dd class="inline text-ink-2">{{this.brief}}</dd></div>
            <div><dt class="inline font-bold">ทีมดีช่วย </dt><dd class="inline text-ink-2">{{this.helped}}</dd></div>
          </dl>
        </div>
      </article>
      {{/each}}
    </div>
    {{else}}
    {{#unless wp}}<p class="pending-ribbon">ยังไม่มีงาน{{item.name}}ที่ได้รับอนุญาตให้เผยแพร่ · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
    <div class="grid md:grid-cols-3 gap-5 mt-4">
      {{#each pp.work.cards}}<article class="pp-card"><span class="img-pending">{{this.img}}</span><h3 class="text-[19px] mt-4">{{this.h}}</h3>{{#each this.facts}}<p class="t-sm mt-1">{{this}}</p>{{/each}}</article>{{/each}}
    </div>
    {{/if}}
  </div>
</section>
{{/if}}

<!-- 09 · รีวิว · ยังไม่มีรีวิวที่ได้รับอนุญาต ต้นแบบเท่านั้น -->
{{#if pp.reviews.show}}
<section class="wrap section" id="reviews">
  <h2 class="t-display text-[clamp(26px,3.4vw,40px)]">{{pp.reviews.h}}</h2>
  {{#unless wp}}<p class="pending-ribbon mt-4">รอคำรีวิว ภาพ คลิป คะแนน และแหล่งที่มาจริงที่ได้รับอนุญาต · ไม่แสดงดาวหรือคำชมสมมติ · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
</section>
{{/if}}

<!-- 10 · ทรงและไซซ์ -->
<section class="wrap section" id="size">
  <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16 items-start">
    <div>
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoRuler}}</span>ไซซ์</span>
      <h2 class="t-display text-[clamp(28px,3.6vw,44px)]">{{pp.size.h}}</h2>
      {{#if pp.size.title}}<h3 class="text-[19px] mt-6">{{pp.size.title}}</h3>{{/if}}
      {{#each pp.size.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}
      {{#each pp.size.links}}<a class="pp-more mt-5" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
    </div>
    <div>
      <div class="overflow-x-auto border-2 border-ink rounded-card" tabindex="0" role="region" aria-label="ตารางไซซ์ เลื่อนซ้ายขวาได้">
        <table class="w-full min-w-[320px] text-[17px]">
          <caption class="text-left font-bold text-[18px] px-5 py-4 border-b-2 border-ink">หน่วยเป็น{{sizing.unit}} วัดจากตัวเสื้อวางราบ · ตารางกลาง ตรวจตามทรงที่สั่งจริง</caption>
          <thead class="bg-ink text-paper"><tr><th scope="col" class="text-left font-bold px-5 py-4">ไซซ์</th><th scope="col" class="text-right font-bold px-5 py-4">รอบอก</th><th scope="col" class="text-right font-bold px-5 py-4">ความยาว</th><th scope="col" class="text-right font-bold px-5 py-4">ไหล่</th></tr></thead>
          <tbody>{{#each pp.size.sizes}}<tr class="border-t border-line"><th scope="row" class="text-left font-bold px-5 py-3.5">{{this.size}}</th><td class="px-5 py-3.5 text-right tabular-nums">{{this.chest}}</td><td class="px-5 py-3.5 text-right tabular-nums">{{this.length}}</td><td class="px-5 py-3.5 text-right tabular-nums">{{this.shoulder}}</td></tr>{{/each}}</tbody>
        </table>
      </div>
      <p class="t-xs mt-3">{{sizing.tolerance}}</p>
      {{#each pp.size.notes}}<p class="t-xs mt-1">{{this}}</p>{{/each}}
    </div>
  </div>
</section>

<!-- 11 · ขั้นตอนสั่งทำ -->
<section class="bg-shell border-y border-line" id="order">
  <div class="wrap section grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16 items-start">
    <div>
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoClock}}</span>ขั้นตอน</span>
      <h2 class="t-display text-[clamp(28px,3.6vw,44px)]">{{pp.order.h}}</h2>
      <ol class="mt-6 border-t-2 border-ink">
        {{#each pp.order.steps}}<li class="why-row"><span class="why-row__no">0{{inc @index}}</span><div class="why-row__body"><h3 class="why-row__t">{{this.h}}</h3>{{#if this.p}}<p class="why-row__d">{{this.p}}</p>{{/if}}</div></li>{{/each}}
      </ol>
      {{#each pp.order.links}}<a class="pp-more mt-5" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
    </div>
    {{#if pp.order.payment.p.length}}
    <div class="bg-paper border border-line rounded-plate p-7">
      <h3 class="text-[19px]">{{pp.order.payment.h}}</h3>
      <ul class="mt-4 space-y-2.5">{{#each pp.order.payment.p}}<li class="pp-dot">{{this}}</li>{{/each}}</ul>
    </div>
    {{/if}}
  </div>
</section>

<!-- 12 · คำถามก่อนสั่ง -->
{{#if pp.faq.show}}
<section class="wrap section" id="faq">
  <div class="max-w-[68ch] mb-8">
    <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoChat}}</span>คำถามที่พบบ่อย</span>
    <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{pp.faq.h}}</h2>
  </div>
  <div class="hs-accordion-group border-t-2 border-ink max-w-[820px]">
    {{#each pp.faq.items}}
    <div class="hs-accordion border-b border-line" id="pfaq-{{@index}}">
      <button type="button" class="hs-accordion-toggle w-full flex items-start justify-between gap-5 text-left py-6 min-h-tap font-bold text-[19px] hover:underline decoration-orange decoration-2 underline-offset-4" aria-expanded="false" aria-controls="pfaq-panel-{{@index}}">
        <span>{{this.[0]}}</span>
        <svg class="shrink-0 mt-1.5 transition-transform hs-accordion-active:rotate-45 text-orange" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div id="pfaq-panel-{{@index}}" class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300">
        <p class="t-body pb-7 max-w-[62ch]">{{this.[1]}}</p>
      </div>
    </div>
    {{/each}}
  </div>
  <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6">
    <a class="pp-more" href="{{url 'faq'}}">คำถามที่พบบ่อยฉบับเต็ม<span class="arw" aria-hidden="true">&rarr;</span></a>
    {{#each pp.faq.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}
  </div>
</section>
{{/if}}

<!-- 13 · เลือกตามงานที่ใช้ -->
<section class="bg-shell border-y border-line">
  <div class="wrap section">
    <h2 class="t-display text-[clamp(24px,3vw,36px)]">{{pp.uses.h}}</h2>
    {{#if pp.uses.links.length}}<div class="chiprail mt-6">{{#each pp.uses.links}}<a class="chip" href="{{url this.to}}">{{this.t}}</a>{{/each}}</div>{{/if}}
    {{#if pp.uses.compare.length}}
    <p class="t-body mt-6">อยากเปรียบเทียบกับงานแบบอื่น?
      {{#each pp.uses.compare}}<a class="font-semibold text-ink underline decoration-orange decoration-2 underline-offset-4" href="{{url this.to}}">{{this.t}}</a>{{#unless @last}} · {{/unless}}{{/each}}
    </p>
    {{/if}}
  </div>
</section>

<!-- 14 · เริ่มสั่ง -->
<section class="band-orange">
  <div class="wrap py-14 md:py-20 text-center">
    <h2 class="t-display text-[clamp(28px,4vw,48px)] text-paper">{{pp.contact.h}}</h2>
    <p class="text-[18px] leading-[1.75] text-paper/90 max-w-[52ch] mx-auto mt-4">{{pp.contact.p}}</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a class="btn btn-lg bg-paper text-ink border-paper hover:bg-ink hover:text-paper hover:border-ink gap-2" href="{{site.lineUrl}}" data-track="line"><span class="block size-5">{{> icoChat}}</span>ทัก LINE ขอราคา</a>
      <a class="btn btn-lg bg-transparent text-paper border-paper/70 hover:bg-paper hover:text-ink hover:border-paper max-sm:whitespace-normal" href="{{url 'contact'}}?p={{item.id}}">{{pp.contact.cta}}</a>
    </div>
  </div>
</section>
