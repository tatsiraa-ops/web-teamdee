{{!-- หน้ารวมเสื้อแบบพิเศษ (Wireframe v4 · หน้าใหม่) · เลือก 3 ทรง → เปรียบเทียบจากการใช้งาน → CTA
     ลูกแต่ละทรงมีหน้ารายละเอียดของตัวเอง (productPage) --}}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"สินค้าและบริการ"},{"@type":"ListItem","position":3,"name":"{{item.name}}"}]}</script>

<section class="band-ink relative overflow-hidden">
  <span class="absolute inset-x-0 top-0 h-1 bg-orange z-10" aria-hidden="true"></span>
  <div class="wrap relative py-12 md:py-18">
    <nav class="crumb2" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>สินค้าและบริการ</span><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <h1 class="t-display text-[clamp(32px,4.8vw,60px)] text-paper mt-8">{{item.name}}</h1>
    <p class="text-[19px] leading-[1.75] text-paper/75 max-w-[52ch] mt-5">{{item.lead}}</p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a class="btn btn-orange btn-lg" href="{{url 'contact'}}?p={{item.id}}">ให้ทีมดีช่วยเลือก</a>
    </div>
  </div>
</section>

<section class="wrap section" aria-labelledby="pick-shape-h">
  <h2 id="pick-shape-h" class="t-display text-[clamp(26px,3.4vw,42px)] mb-8">เลือกประเภทเสื้อ</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {{#each childProducts}}
    <a href="{{url 'products' this.id}}" class="group flex flex-col border border-line rounded-plate overflow-hidden hover:border-ink transition-colors">
      <div class="relative bg-paper aspect-[3/2]">
        {{#if this.img}}<img src="{{this.img}}" alt="{{this.name}}" width="1080" height="720" loading="lazy" decoding="async" class="w-full h-full object-contain">{{else}}<div class="img-pending" role="img" aria-label="ยังไม่มีภาพ{{this.name}}">{{this.imgNote}}</div>{{/if}}
        {{#if this.img}}<span class="tag tag-ink absolute left-3 top-3 max-w-[calc(100%-1.5rem)]">{{#if this.imgNote}}{{this.imgNote}}{{else}}ภาพจำลอง{{/if}}</span>{{/if}}
        {{#if this.isNew}}<span class="tag absolute right-3 top-3">สินค้าใหม่</span>{{/if}}
      </div>
      <div class="p-6 grow">
        <h3 class="text-[21px] group-hover:underline decoration-orange decoration-2 underline-offset-4">{{this.name}} &rarr;</h3>
        <p class="t-sm mt-2">{{this.lead}}</p>
      </div>
    </a>
    {{/each}}
  </div>
</section>

<section class="bg-shell border-y border-line" aria-labelledby="compare-h">
  <div class="wrap section">
    <h2 id="compare-h" class="t-display text-[clamp(26px,3.4vw,42px)] mb-8">เปรียบเทียบจากการใช้งาน</h2>
    <div class="overflow-x-auto border-2 border-ink rounded-card bg-paper">
      <table class="w-full min-w-[480px] text-[17px]">
        <thead class="bg-ink text-paper"><tr><th scope="col" class="text-left font-bold px-5 py-4">ทรง</th><th scope="col" class="text-left font-bold px-5 py-4">ดูอะไรก่อนตัดสินใจ</th></tr></thead>
        <tbody>
          {{#each compareRows}}<tr class="border-t border-line"><th scope="row" class="text-left font-bold px-5 py-4"><a class="inline-flex items-center min-h-[44px] underline decoration-orange decoration-2 underline-offset-4" href="{{url 'products' this.item.id}}">{{this.item.name}}</a></th><td class="px-5 py-4 text-ink-2">{{this.note}}</td></tr>{{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="band-orange">
  <div class="wrap py-14 md:py-20 text-center">
    <h2 class="t-display text-[clamp(28px,4vw,48px)] text-ink">มีสไตล์ในใจ ให้ทีมดีช่วยต่อยอด</h2>
    <p class="text-[18px] leading-[1.75] text-ink/85 max-w-[48ch] mx-auto mt-4">บอกว่าใครใส่ จำนวนประมาณเท่าไร และใช้วันไหน ยังไม่มีแบบก็เริ่มคุยได้</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a class="btn btn-lg bg-paper text-ink border-paper hover:bg-ink hover:text-paper hover:border-ink" href="{{site.lineUrl}}" data-track="line">ทัก LINE ทีมดี</a>
      <a class="btn btn-lg bg-transparent text-ink border-ink/60 hover:bg-ink hover:text-paper hover:border-ink" href="{{url 'contact'}}?p={{item.id}}">ฝากข้อมูลให้ติดต่อกลับ</a>
    </div>
  </div>
</section>
