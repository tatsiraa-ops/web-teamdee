{{!-- เสื้อสกรีน DTF: options + fabric + detail ตาม v22 · งานจริงแยกไป screenWork.hbs (2 พ.ย.)
     18 พ.ย. 2026 ข้อมูลเสื้อ สี ขนาดลาย จาก prices.json → products.screen ผ่าน screenPage (src/build/pages/products.js) · สไลด์ "ขายงานสกรีน DTF" 17 พ.ย. 2026 --}}
<section class="wrap section screen-choice" id="options">
  <header class="screen-heading"><span class="eyebrow">ตัวเสื้อ</span><h2 class="t-display">{{pp.options.h}}</h2><p class="t-lead">เริ่มจากทรงที่ทีมอยากใส่ แล้วค่อยเติมลายที่เป็นคุณ</p></header>
  {{> ppOptCards}}
  <div class="screen-material" id="fabric">
    <figure class="screen-material__photo"><img src="/img/screen/studio-317.webp" width="1200" height="800" alt="ตัวอย่างเสื้อคอตตอนพับซ้อน ให้เห็นสีและผิวผ้า" loading="lazy"><figcaption>สีบนจอเป็นสีประมาณ ขอดูผ้าจริงได้ก่อนตัดสินใจ</figcaption></figure>
    <div><h2 class="screen-subtitle">{{pp.fabric.h}}</h2>
      {{#each screenPage.shirts}}
      <article class="screen-fit"><h3>{{this.name}}</h3><p>Cotton 100% · {{this.fit}} · คอกลม แขนสั้น{{#if this.add}} · <b>+{{this.add}} บาท/ตัว</b>{{/if}}</p>
        <ul class="screen-colors" aria-label="สี {{this.name}}">{{#each this.colors}}<li><i style="--swatch:{{this.hex}}" aria-hidden="true"></i>{{this.name}}{{#if this.note}} <small>{{this.note}}</small>{{/if}}</li>{{/each}}</ul></article>
      {{/each}}
      <a class="pp-more" href="{{ppNextLine.fabric}}" data-track="line">ขอดูตัวอย่างผ้า <span aria-hidden="true">→</span></a> <a class="pp-more" href="{{url 'guides.fabric'}}">วิธีเลือกผ้า <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<section class="screen-print" id="detail"><div class="wrap section">
  <header class="screen-heading"><span class="eyebrow">ลายของทีม</span><h2 class="t-display">{{pp.detail.h}}</h2><p class="t-lead">ขนาดลาย 5 ขนาด เทียบกรอบบนเสื้อไซซ์ L · ลายเกินกรอบใช้ราคาขนาดถัดไป</p></header>
  <div class="screen-sizes">
    {{!-- เส้นเสื้อ + กรอบลาย วาดด้วย SVG (ไม่ใช้ภาพจำลองจากสไลด์) · สัดส่วนกรอบตามซม. บนเสื้อไซซ์ L --}}
    <svg class="screen-sizes__art" viewBox="0 0 300 320" role="img" aria-label="กรอบขนาดลาย A7 ถึง A3 บนเสื้อ">
      <path d="M96 22 52 40 14 96l40 24 18-24v204h156V96l18 24 40-24-38-56-44-18c-8 20-30 32-54 32S104 42 96 22Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <rect x="90" y="70" width="120" height="160" rx="3" fill="none" stroke="var(--color-orange)" stroke-width="1.6" stroke-dasharray="5 4"/><text x="200" y="224" text-anchor="end">A3</text>
      <rect x="110" y="78" width="80" height="120" rx="3" fill="none" stroke="var(--color-orange)" stroke-width="1.6" stroke-dasharray="5 4"/><text x="184" y="192" text-anchor="end">A4</text>
      <rect x="120" y="86" width="60" height="80" rx="3" fill="none" stroke="var(--color-orange)" stroke-width="1.6" stroke-dasharray="5 4"/><text x="174" y="160" text-anchor="end">A5</text>
      <rect x="130" y="94" width="40" height="60" rx="3" fill="none" stroke="var(--color-orange)" stroke-width="1.6" stroke-dasharray="5 4"/><text x="166" y="148" text-anchor="end">A6</text>
      <rect x="182" y="70" width="20" height="28" rx="2" fill="var(--color-orange)" fill-opacity=".14" stroke="var(--color-orange)" stroke-width="1.6"/><text x="192" y="64" text-anchor="middle">A7</text>
    </svg>
    <div>
      <ul class="screen-sizes__list">{{#each screenPage.S.sizes}}<li><b>{{this.id}}</b> <span>{{this.cm}} ซม.</span> <small>{{this.use}}</small></li>{{/each}}</ul>
      <div class="screen-included"><b>รวมสกรีน 1 จุดในราคาเสื้อ</b><span>ลายที่ใหญ่ที่สุดคิดเป็นจุดแรก · จุดที่ 2–3 คิดตามขนาด สูงสุด 3 จุดต่อตัว</span></div>
      <a class="pp-more" href="{{url 'guides.screen'}}">ดูคู่มือสั่งเสื้อสกรีน <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div></section>
