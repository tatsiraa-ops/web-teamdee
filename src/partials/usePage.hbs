{{!-- หน้ากลุ่มลูกค้า 10 หน้า ตาม Wireframe v22 (22 ต.ค. 2026)
     ข้อความ: src/data/use-pages.json (scripts/v22/use-pages.mjs) · ของจริง: แบบเสื้อรหัส TD · ผลงาน · ภาพลูกค้า
     src/js/use-view.js ตัดข้อความที่รอยืนยันออกบนเว็บจริง · ส่วนที่ยังไม่มีของจริงซ่อน · ต้นแบบโชว์พร้อมป้าย --}}
{{#if useLd}}<script type="application/ld+json">{{{useLd}}}</script>
{{/if}}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"หน้าแรก","item":"{{site.baseUrl}}/"},{"@type":"ListItem","position":2,"name":"{{item.name}}"}]}</script>

<!-- 01 · hero -->
<section class="band-hero relative overflow-hidden">
  <span class="absolute inset-x-0 top-0 h-1 bg-orange z-10" aria-hidden="true"></span>
  <div class="wrap relative py-12 md:py-18">
    <nav class="crumb2" aria-label="เส้นทางหน้า"><a href="/">หน้าแรก</a><span aria-hidden="true">/</span><span>เลือกตามการใช้งาน</span><span aria-hidden="true">/</span><span aria-current="page">{{item.name}}</span></nav>
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center mt-8">
      <div>
        <h1 class="t-display text-[clamp(30px,4.4vw,54px)] text-ink">{{up.hero.h1}}</h1>
        <p class="text-[19px] leading-[1.75] text-ink-2 max-w-[52ch] mt-5">{{up.hero.lead}}</p>
        {{#if item.seoLine}}<p class="text-[17px] leading-[1.7] text-ink-2 max-w-[56ch] mt-3">{{item.seoLine}}</p>{{/if}}
        {{#if up.hero.facts.length}}<ul class="flex flex-wrap gap-2 mt-7">{{#each up.hero.facts}}<li class="tag">{{this}}</li>{{/each}}</ul>{{/if}}
        <div class="flex flex-wrap gap-3 mt-9">
          <a class="btn btn-orange btn-lg max-sm:whitespace-normal max-sm:text-center max-sm:py-3" href="{{cta.primary.href}}">{{cta.primary.label}}</a>
          {{#if up.designs.show}}<a class="btn btn-lg bg-transparent text-ink border-ink/40 hover:bg-ink hover:text-ink hover:border-ink max-sm:whitespace-normal" href="#designs">{{up.hero.cta2}}</a>{{/if}}
        </div>
      </div>
      <figure class="relative">
        <div class="overflow-hidden rounded-plate bg-shell aspect-[4/3]">
          {{#if item.img}}<img src="{{item.img}}" alt="{{item.name}} · ทีมลูกค้าใส่เสื้อที่ทีมดีผลิต" width="900" height="675" fetchpriority="high" decoding="async" class="w-full h-full object-cover {{item.imgPos}}">
          {{else}}<span class="prod-noimg" role="img" aria-label="ยังไม่มีภาพ{{item.name}}"><span class="block size-14">{{> icoUsers}}</span><span>{{item.name}}</span></span>{{/if}}
        </div>
        {{#if item.img}}<figcaption class="tag {{#unless (eq item.imgKind 'real')}}tag-ink{{/unless}} absolute left-4 bottom-4">{{#if (eq item.imgKind 'real')}}งานผลิตจริง{{else}}ภาพจำลอง{{/if}}</figcaption>{{/if}}
      </figure>
    </div>
  </div>
</section>

{{#if up.toc.length}}
<nav class="border-b border-line bg-paper" aria-label="ข้ามไปยังหัวข้อในหน้านี้">
  <div class="wrap chiprail py-3">{{#each up.toc}}<a class="chip" href="#{{this.key}}">{{this.t}}</a>{{/each}}</div>
</nav>
{{/if}}

<!-- 02 · แบบเสื้อของกลุ่มนี้ · ย้ายขึ้นมาต่อจาก hero (agent ลูกค้า 22 ต.ค.: บนมือถือต้องเลื่อนผ่าน 4 ส่วนกว่าจะเจอแบบ) · v22 เดิมอยู่ลำดับ 05 (รหัส TD จริง) -->
{{#if up.designs.show}}
<section class="wrap section" id="designs">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div class="max-w-[62ch]">
      <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoShirt}}</span>แบบเสื้อ</span>
      <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{up.designs.h}}</h2>
      {{#each up.designs.intro}}<p class="t-lead mt-4">{{this}}</p>{{/each}}
    </div>
    {{#if up.designs.items.length}}<a class="pp-more" href="{{url 'galleries' item.id}}">ดูแบบทั้งหมด {{useDesignsAll}} แบบ<span class="arw" aria-hidden="true">&rarr;</span></a>{{/if}}
  </div>
  {{#unless up.designs.items.length}}{{#unless wp}}<p class="pending-ribbon">ยังไม่มีแบบ{{item.name}}ในคลัง (ทีมดีไซน์ยืนยันรหัสแบบและกลุ่มลูกค้าก่อน) · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}{{/unless}}
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-3" id="useGrid" data-line-url="{{site.lineUrl}}">
    {{#each up.designs.items}}
    {{#if this.square}}
    <figure class="overflow-hidden rounded-card bg-paper border border-line aspect-[3/2]" data-code="" data-meta="แบบจากคลังผลงานทีมดี">
      <img src="{{this.img}}" width="1080" height="1080" loading="lazy" decoding="async" alt="{{this.alt}}" class="w-full h-full object-contain">
    </figure>
    {{else}}
    <figure class="overflow-hidden rounded-card bg-paper border border-line aspect-[3/2]" data-code="{{this.code}}" data-meta="{{this.meta}}">
      <img src="{{this.img}}" srcset="{{this.imgSmall}} 540w, {{this.img}} 1080w" sizes="(min-width:1024px) 33vw, 50vw" width="1080" height="720" loading="lazy" decoding="async" alt="แบบ{{this.garmentName}} รหัส {{this.code}} ด้านหน้าและด้านหลัง" class="w-full h-full object-contain">
    </figure>
    {{/if}}
    {{/each}}
  </div>
</section>
{{/if}}

<!-- 02 · สถิติและโลโก้ลูกค้า · รอยืนยัน ต้นแบบเท่านั้น -->
{{#if up.trust.show}}
<section class="wrap pt-12">
  {{#unless wp}}<p class="pending-ribbon">สถิติและโลโก้ลูกค้ารอยืนยันและขออนุญาต · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
  <h2 class="t-display text-[clamp(22px,2.6vw,30px)]">{{up.trust.h}}</h2>
  <dl class="grid sm:grid-cols-3 gap-4 mt-5 max-w-[760px]">{{#each up.trust.stats}}<div class="pp-card"><dt class="t-sm">{{this.t}}</dt><dd class="text-[20px] font-bold mt-1">{{this.n}}</dd></div>{{/each}}</dl>
</section>
{{/if}}

<!-- 03 · โจทย์ของคนสั่ง -->
{{#if up.pain.show}}
<section class="wrap section">
  <div class="max-w-[62ch] mb-8">
    <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoUsers}}</span>โจทย์ของคนสั่ง</span>
    <h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{up.pain.h}}</h2>
    {{#each up.pain.intro}}<p class="t-lead mt-4">{{this}}</p>{{/each}}
  </div>
  <ol class="grid md:grid-cols-3 gap-4">
    {{#each up.pain.cards}}<li class="pp-card"><span class="pp-card__no">{{inc @index}}</span><h3 class="text-[20px] mt-3">{{this.h}}</h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}</li>{{/each}}
  </ol>
</section>
{{/if}}

<!-- 04 · บริบทงาน (บริษัท / หน่วยงาน) -->
{{#if up.contexts.show}}
<section class="bg-shell border-y border-line">
  <div class="wrap section">
    <h2 class="t-display text-[clamp(26px,3.4vw,40px)] max-w-[30ch]">{{up.contexts.h}}</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-8">
      {{#each up.contexts.cards}}<article class="pp-card">{{#if this.photo}}<img src="{{this.photo.img}}" alt="{{this.photo.alt}}" width="1080" height="1080" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover rounded-card">{{/if}}{{#if this.img}}<span class="img-pending">{{this.img}}</span>{{/if}}<h3 class="text-[19px] {{#if this.img}}mt-4{{/if}}{{#if this.photo}}mt-4{{/if}}">{{this.h}}</h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}</article>{{/each}}
    </div>
    <div class="flex flex-wrap gap-x-6 mt-6">{{#each up.contexts.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}<a class="pp-more" href="{{cta.primary.href}}">{{cta.primary.label}}<span class="arw" aria-hidden="true">&rarr;</span></a></div>
  </div>
</section>
{{/if}}

<!-- 06 · ประเภทเสื้อที่เหมาะ -->
{{#if up.products.show}}
<section class="bg-shell border-y border-line" id="products">
  <div class="wrap section">
    <h2 class="t-display text-[clamp(26px,3.4vw,40px)] max-w-[30ch]">{{up.products.h}}</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-8">
      {{#each up.products.cards}}<a class="pp-card group block" href="{{url this.to}}"><h3 class="text-[20px] group-hover:underline decoration-orange decoration-2 underline-offset-4">{{this.h}}<span class="arw" aria-hidden="true">&rarr;</span></h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}<span class="t-sm font-semibold text-ink mt-4 inline-block">ดูผ้า ทรง และรายละเอียด</span></a>{{/each}}
    </div>
  </div>
</section>
{{/if}}

<!-- 07 · ยังไม่แน่ใจ -->
<section class="band-soft">
  <div class="wrap py-12 md:py-14 flex flex-wrap items-center justify-between gap-6">
    <div class="max-w-[56ch]"><h2 class="t-display text-[clamp(24px,3vw,34px)] text-ink">{{up.help.h}}</h2><p class="text-[17px] leading-[1.7] text-ink-2 mt-2">{{up.help.p}}</p></div>
    <a class="btn btn-orange btn-lg" href="{{cta.primary.href}}">{{cta.primary.label}}</a>
  </div>
</section>

<!-- 08 · ผลงานจริง -->
{{#if up.work.show}}
<section class="wrap section" id="work">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
    <div class="max-w-[62ch]"><span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoUsers}}</span>เสื้อจริง</span><h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{up.work.h}}</h2></div>
    <a class="pp-more" href="{{url 'projects'}}">ดูผลงานและรีวิวทั้งหมด<span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
  {{#if up.work.real.length}}
  <div class="grid md:grid-cols-3 gap-5">
    {{#each up.work.real}}
    <article class="bg-paper border border-line rounded-plate overflow-hidden flex flex-col">
      <div class="relative aspect-[4/3] bg-shell"><img src="{{this.img}}" alt="ทีมใส่{{this.title}}จริง" width="600" height="450" loading="lazy" decoding="async" class="w-full h-full object-cover"><span class="tag tag-ink absolute left-3 bottom-3">งานผลิตจริง</span></div>
      <div class="p-6 on-paper grow">
        <p class="t-xs">{{this.groupName}}</p>
        <h3 class="text-[19px] mt-1">{{this.title}}</h3>
        <dl class="mt-3 space-y-2 text-[16px] leading-[1.6]">
          <div><dt class="inline font-bold">โจทย์ </dt><dd class="inline text-ink-2">{{this.brief}}</dd></div>
          <div><dt class="inline font-bold">ทีมดีช่วย </dt><dd class="inline text-ink-2">{{this.helped}}</dd></div>
        </dl>
      </div>
    </article>
    {{/each}}
  </div>
  {{else}}
  {{#unless wp}}<p class="pending-ribbon">ยังไม่มีงาน{{item.name}}ที่ได้รับอนุญาตให้เผยแพร่ · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
  {{/if}}
</section>
{{/if}}

<!-- 09 · รีวิว · ต้นแบบเท่านั้น -->
{{#if up.reviews.show}}
<section class="wrap pb-12" id="reviews">
  <h2 class="t-display text-[clamp(24px,3vw,36px)]">{{up.reviews.h}}</h2>
  {{#unless wp}}<p class="pending-ribbon mt-4">รอคำรีวิว ภาพ คลิป และแหล่งที่มาจริงที่ได้รับอนุญาต · ไม่แสดงดาวหรือคำชมสมมติ · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
</section>
{{/if}}

<!-- 10 · ทำไมทีมดี -->
{{#if up.benefits.show}}
<section class="bg-shell border-y border-line">
  <div class="wrap section">
    <h2 class="t-display text-[clamp(26px,3.4vw,40px)] max-w-[30ch]">{{up.benefits.h}}</h2>
    <div class="pp-auto mt-8">
      {{#each up.benefits.cards}}<article class="pp-card"><h3 class="text-[19px]">{{this.h}}</h3>{{#each this.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}</article>{{/each}}
    </div>
  </div>
</section>
{{/if}}

<!-- 11 · วางงบและขั้นตอน -->
{{#if up.plan.show}}
<section class="wrap section" id="plan">
  <span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoClock}}</span>ข้อมูลก่อนสั่ง</span>
  <h2 class="t-display text-[clamp(28px,3.6vw,44px)] max-w-[30ch]">{{up.plan.h}}</h2>
  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-8">
    <div>
      {{#if up.plan.need}}<h3 class="text-[19px]">{{up.plan.need.h}}</h3><ul class="mt-3 space-y-2.5">{{#each up.plan.need.items}}<li class="pp-dot">{{this}}</li>{{/each}}</ul>{{/if}}
      {{#if up.plan.price}}<h3 class="text-[19px] mt-8">{{up.plan.price.h}}</h3><ul class="mt-3 space-y-2.5">{{#each up.plan.price.p}}<li class="pp-dot">{{this}}</li>{{/each}}</ul>{{/if}}
      <div class="flex flex-wrap gap-x-6 mt-5">{{#each up.plan.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}</div>
    </div>
    <div>
      <ol class="border-t-2 border-ink">{{#each up.plan.steps}}<li class="why-row"><span class="why-row__no">0{{inc @index}}</span><div class="why-row__body"><h3 class="why-row__t">{{this.h}}</h3>{{#if this.p}}<p class="why-row__d">{{this.p}}</p>{{/if}}</div></li>{{/each}}</ol>
      {{#if up.plan.payment}}<div class="bg-shell border border-line rounded-plate p-6 mt-6"><h3 class="text-[18px]">{{up.plan.payment.h}}</h3><ul class="mt-3 space-y-2">{{#each up.plan.payment.p}}<li class="pp-dot">{{this}}</li>{{/each}}</ul></div>{{/if}}
      <a class="btn btn-line mt-6" href="{{cta.primary.href}}">{{cta.primary.label}}</a>
    </div>
  </div>
</section>
{{/if}}

<!-- 12 · ภาพลูกค้าจริง -->
{{#if up.photos.show}}
<section class="bg-shell border-y border-line" id="photos">
  <div class="wrap section">
    <h2 class="t-display text-[clamp(26px,3.4vw,40px)] max-w-[30ch]">{{up.photos.h}}</h2>
    <p class="t-lead mt-3">{{up.photos.intro}}</p>
    {{#if up.photos.items.length}}
    <ul class="pp-photos mt-8" aria-label="ภาพลูกค้าสวมเสื้อ">
      {{#each up.photos.items}}<li><img src="{{this.imgSmall}}" alt="ทีมลูกค้า{{this.catName}}ใส่เสื้อที่ทีมดีผลิต" width="320" height="320" loading="lazy" decoding="async"></li>{{/each}}
    </ul>
    {{else}}
    {{#unless wp}}<p class="pending-ribbon mt-6">รอภาพลูกค้ากลุ่มนี้พร้อมสิทธิ์เผยแพร่ · บนเว็บจริงซ่อนส่วนนี้</p>{{/unless}}
    {{/if}}
  </div>
</section>
{{/if}}

<!-- 13 · มีวันใช้แล้ว -->
<section class="band-soft">
  <div class="wrap py-12 md:py-14 flex flex-wrap items-center justify-between gap-6">
    <div class="max-w-[56ch]"><h2 class="t-display text-[clamp(24px,3vw,34px)] text-ink">{{up.schedule.h}}</h2><p class="text-[17px] leading-[1.7] text-ink-2 mt-2">{{up.schedule.p}}</p>
      {{#unless wp}}<p class="pending-ribbon mt-3">รอข้อมูลจากทีม: ผลิตกี่วันทำการหลังยืนยันแบบ (แยกพิมพ์ลาย / ปัก) และคิวต่อเดือน · ได้แล้วจะบอกทันทีว่าทันวันที่เลือกไหม</p>{{/unless}}
    </div>
    <div class="flex flex-wrap items-end gap-3 w-full sm:w-auto">
      <div class="w-full sm:w-auto"><label class="label" for="useDate">วันที่ต้องใช้เสื้อ</label><input class="input sm:w-[200px]" id="useDate" type="date"></div>
      <a class="btn btn-orange btn-lg max-sm:w-full max-sm:whitespace-normal max-sm:text-center max-sm:py-3 js-date-cta" href="{{cta.primary.href}}">{{cta.primary.label}}</a>
    </div>
  </div>
</section>

<!-- 14 · คำถามก่อนสั่ง -->
{{#if up.faq.show}}
<section class="wrap section" id="faq">
  <div class="max-w-[68ch] mb-8"><span class="eyebrow"><span class="block size-[18px] shrink-0">{{> icoChat}}</span>คำถามที่พบบ่อย</span><h2 class="t-display text-[clamp(28px,3.8vw,46px)]">{{up.faq.h}}</h2></div>
  <div class="hs-accordion-group border-t-2 border-ink max-w-[820px]">
    {{#each up.faq.items}}
    <div class="hs-accordion border-b border-line" id="ufaq-{{@index}}">
      <button type="button" class="hs-accordion-toggle w-full flex items-start justify-between gap-5 text-left py-6 min-h-tap font-bold text-[19px] hover:underline decoration-orange decoration-2 underline-offset-4" aria-expanded="false" aria-controls="ufaq-panel-{{@index}}">
        <span>{{this.[0]}}</span>
        <svg class="shrink-0 mt-1.5 transition-transform hs-accordion-active:rotate-45 text-orange" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div id="ufaq-panel-{{@index}}" class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300"><p class="t-body pb-7 max-w-[62ch]">{{this.[1]}}</p></div>
    </div>
    {{/each}}
  </div>
  <a class="pp-more mt-6" href="{{url 'faq'}}">คำถามที่พบบ่อยฉบับเต็ม<span class="arw" aria-hidden="true">&rarr;</span></a>
</section>
{{/if}}

<!-- 15 · ทีมดีและกลุ่มใกล้เคียง -->
<section class="bg-shell border-y border-line">
  <div class="wrap section grid lg:grid-cols-2 gap-10 lg:gap-16">
    <div>
      <h2 class="t-display text-[clamp(24px,3vw,36px)]">{{up.team.h}}</h2>
      <h3 class="text-[18px] mt-5">{{up.team.title}}</h3>
      {{#each up.team.p}}<p class="t-body mt-2">{{this}}</p>{{/each}}
      <p class="t-body mt-2">{{site.address}} · {{site.hours}}</p>
      <div class="flex flex-wrap gap-x-6 mt-4">{{#each up.team.links}}<a class="pp-more" href="{{url this.to}}">{{this.t}}<span class="arw" aria-hidden="true">&rarr;</span></a>{{/each}}</div>
    </div>
    {{#if up.related.show}}
    <div>
      <h2 class="t-display text-[clamp(22px,2.6vw,30px)]">{{up.related.h}}</h2>
      <div class="chiprail mt-5">{{#each up.related.links}}<a class="chip" href="{{url this.to}}">{{this.t}}</a>{{/each}}</div>
    </div>
    {{/if}}
  </div>
</section>

<section class="band-orange">
  <div class="wrap py-14 md:py-20 text-center">
    <h2 class="t-display text-[clamp(28px,4vw,48px)] text-paper">เล่าโจทย์ของทีมคุณมา</h2>
    <p class="text-[18px] leading-[1.75] text-paper/90 max-w-[48ch] mx-auto mt-4">บอกว่าใครใส่ จำนวนประมาณ และใช้วันไหน ยังไม่มีแบบก็เริ่มได้</p>
    <div class="flex flex-wrap justify-center gap-3 mt-8">
      <a class="btn btn-lg bg-paper text-ink border-paper hover:bg-ink hover:text-paper hover:border-ink gap-2" href="{{cta.primary.href}}">{{#if (eq cta.mode 'line')}}<span class="block size-5">{{> icoChat}}</span>{{/if}}{{cta.primary.label}}</a>
      <a class="btn btn-lg bg-transparent text-paper border-paper/70 hover:bg-paper hover:text-ink hover:border-paper tabular-nums" href="{{cta.secondary.href}}">{{cta.secondary.label}}</a>
    </div>
    {{#if (eq cta.mode 'line')}}<p class="text-[16px] text-paper/90 mt-5">หรือโทร <a class="font-bold underline underline-offset-4 tabular-nums" href="{{cta.tel.href}}">{{cta.tel.label}}</a> · {{site.hours}}</p>{{else}}<p class="text-[16px] text-paper/90 mt-5">ขอเอกสารจัดซื้อได้ ใบเสนอราคา ใบกำกับภาษี · {{site.hours}}</p>{{/if}}
  </div>
</section>
