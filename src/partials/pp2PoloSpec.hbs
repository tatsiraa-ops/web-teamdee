{{!-- 11 พ.ย. 2026 หน้างานปัก: แบบเสื้อมาตรฐาน (spec ข้อ 8 · แทน pp2Types/pp2Collars ของพิมพ์ลาย · id="options" เดิม) · แบบมาตรฐาน 6 ข้อจากไดรฟ์ "Info ปัก" (polo.json spec)
     12 พ.ย. รอบ 213 (อาร์ต "ใช้งานยาก คำเยอะเกินไป ให้กดเยอะเกิน ข้อมูลที่ควรให้ลูกค้าดูเลยไม่แสดง"):
     - ตำแหน่งปัก = ผังเสื้อ + รายการสั้น ชื่อตำแหน่ง | ขนาด (เดิมการ์ดภาพ 6 ใบ · ภาพ pos-6 มีเบอร์โทรลูกค้า จึงไม่ใช้)
     - รายละเอียดเสื้อ 28 แบบ เห็นครบไม่ต้องกด (เดิมแท็บ 5 กลุ่ม ซ่อน 22 แบบ) · ใต้ภาพเหลือชื่อแบบ คำบรรยายย้ายไปอยู่ใน alt
     - ตัดการ์ด "ตัวอย่างจากงานลูกค้าจริง" 4 ใบ (คอซิป ปกขลิบ ต่อสี ซ้ำกับแบบด้านบน) → ปุ่ม LINE ปุ่มเดียวท้ายส่วน
     ข้อมูลคู่มือสั่งเสื้อโปโลปัก TEAMDEE (polo.json guide) · ภาพครอปจากคู่มือ = ภาพจำลอง --}}
{{#with pp2.poloSpec}}
<section class="ps2" id="options" aria-labelledby="ps2-h">
  <div class="wrap">
    <header class="ps2__head">
      <h2 id="ps2-h">{{{hl h accent}}}</h2>
      <p>{{{ph p}}}</p>
    </header>
    <div class="ps2__std">
      <figure class="ps2__img"><img src="{{img}}-760.webp" srcset="{{img}}-480.webp 480w, {{img}}-760.webp 760w, {{img}}-1200.webp 1200w" sizes="(min-width:1024px) 520px, 92vw" width="1200" height="1112" alt="{{alt}}" loading="lazy" decoding="async"></figure>
      <div class="ps2__list">
        <div class="ps2__list-head"><h3 class="ps2__lh">{{stdH}}</h3><p class="ps2__min">เริ่ม {{minQty}} ตัว</p></div>
        <ul class="ps2__spec">{{#each spec}}<li class="ps2__si ps2__si--{{this.k}}">
          <div class="ps2__visual{{#if this.detail}} ps2__visual--detail{{/if}}" aria-hidden="true">{{#if this.art}}<img src="{{this.art}}" width="72" height="72" alt="" loading="lazy" decoding="async">{{else}}<span class="ps2__measure">{{this.measure}}<small>นิ้ว</small></span>{{/if}}</div>
          <div class="ps2__copy"><b>{{this.t}}</b><span>{{this.s}}</span></div>
        </li>{{/each}}</ul>
        <a class="ps2__next" href="#embroidery-spots">ดูตำแหน่งปักและรายละเอียดที่เลือกได้ <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    {{#if guide}}
    {{!-- Keep the five numbered positions matched to the garment map; special work is assessed separately. --}}
    <div class="ps2__pos" id="embroidery-spots">
      <h3 class="ps2__oh">{{guideH}}</h3>
      <p class="ps2__op">{{{ph guideP}}}</p>
      {{!-- 16 พ.ย. 2026 อาร์ต "ตำแหน่งปัก เอาเป็นตัวเสื้อหน้าหลัง และเอาแบบมีเส้นแล้วชี้ไปในแต่ละจุดมาพอ" · กดป้ายดูรูปงานปักจุดนั้นใหญ่ได้ --}}
      {{> shirtCallouts id="emb-pos" img=guide.shirt.img alt="ภาพจำลอง: เสื้อโปโล TEAMDEE ด้านหน้าและด้านหลัง เส้นชี้ตำแหน่งปัก 01–05" points=guide.shirt.pos}}
      {{#each guide.positions}}{{#if this.special}}<div class="ps2__special"><b>{{this.t}}</b><span>{{this.s}}</span><a href="{{../guide.specialAsk}}" data-track="line" data-where="pp-special">ส่งแบบให้ประเมิน <span aria-hidden="true">↗</span></a></div>{{/if}}{{/each}}
      <p class="ps2__gnote">{{guide.posNote}}</p>
    </div>
    <div class="ps2__parts" id="polo-details">
      <h3 class="ps2__oh">{{partsH}}</h3>
      <p class="ps2__op">กดรูปเพื่อดูแบบใหญ่ แล้วบอกแบบที่ชอบในแชทได้เลย</p>
      {{!-- 16 พ.ย. 2026 อาร์ต "ทำเป็นเสื้อของเราหน้าหลัง และชี้ไปยังจุดต่างๆ · กดรูปแต่ละออปชันมีป๊อปอัป · ไม่ต้องให้กดเลือกแล้ว" --}}
      {{> shirtCallouts id="emb-parts" img=guide.shirt.img alt="ภาพจำลอง: เสื้อโปโล TEAMDEE ด้านหน้าและด้านหลัง เส้นชี้ ปก สาบ กระเป๋า ปลายแขน และตัดต่อ" points=guide.shirt.parts}}
      <div class="ps2__groups">
        {{#each guide.groups}}<section class="ps2__grp" aria-labelledby="grp-{{this.k}}">
          <div class="ps2__gh"><h4 id="grp-{{this.k}}"><span class="ps2__group-no" aria-hidden="true">0{{inc @index}}</span>{{this.t}} <span class="ps2__group-count">{{this.items.length}} แบบ</span></h4>{{#if this.note}}<p>{{this.note}}</p>{{/if}}</div>
          <ul class="ps2__pr" id="ps2-grp-{{this.k}}">{{#each this.items}}<li class="ps2__pi"><figure class="ps2__opt"><span class="ps2__pim"><img src="{{this.src}}" width="{{this.w}}" height="{{this.h}}" alt="ภาพจำลอง: {{this.t}} · {{this.s}}" loading="lazy" decoding="async"></span><figcaption>{{this.t}}</figcaption></figure></li>{{/each}}</ul>
        </section>{{/each}}
      </div>
      {{!-- 16 พ.ย. 2026 อาร์ต "ทำมาดีๆหน่อย" · ไม่มีการเลือกแล้ว → ไม่มี "ล้างที่เลือก" · ปุ่ม LINE เขียวชุดเดียวกับทั้งเว็บ --}}
      <div class="ps2__help">
        <img class="ps2__help-ico" src="/img/icons/help-think.webp" alt="" width="120" height="120" loading="lazy" decoding="async">
        <div class="ps2__help-copy">
          <h4>ยังไม่แน่ใจ ให้ทีมดีช่วยเลือก</h4>
          <p>บอกงานที่จะใช้ หรือส่งรูปเสื้อที่ชอบมาในแชท ทีมดีแนะนำปก สาบ ปลายแขน และสีที่เข้ากับทีมให้</p>
          <small>{{guide.imgNote}}</small>
        </div>
        <a class="cb cb--p ps2__help-cta" href="{{ask}}" data-track="line" data-where="pp-options"><span class="cb__ico" aria-hidden="true">{{> icoLine}}</span><span class="cb__t">ให้ทีมดีช่วยเลือก</span></a>
      </div>
    </div>
    {{/if}}
  </div>
</section>
{{/with}}
