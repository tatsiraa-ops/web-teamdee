<a class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:left-2 focus:top-2 focus:bg-orange focus:text-ink focus:px-5 focus:py-3 focus:font-bold" href="#main">ข้ามไปเนื้อหาหลัก</a>

{{!-- ไม่มีเส้นส้มใต้หัวเว็บทุกหน้า (อาร์ต 26 ต.ค. "ลบเส้นส้มด้านล่างสุดออก" · ก่อนหน้านี้ให้มีทุกหน้าหรือไม่มีทุกหน้า) · เหลือเส้นเทาบางแบ่งหัวเว็บ --}}
<header class="sticky top-0 z-50 bg-paper border-b border-line relative" data-header>
  {{!-- เมนูหลักอยู่กลางแถบ (อาร์ต 21 ต.ค. 2026) · จอ 1400+ กลางจอพอดีด้วย grid 3 ช่อง · 1280–1399 ที่ไม่พอ กลางช่องระหว่างโลโก้กับปุ่ม --}}
  <div class="wrap-full flex items-center gap-2 min-h-[76px] min-[1400px]:grid min-[1400px]:grid-cols-[1fr_auto_1fr]">

    <a class="flex items-center gap-2.5 flex-none min-h-tap mr-2 sm:mr-4 xl:mr-8 justify-self-start" href="/" aria-label="TEAMDEE หน้าแรก">
      <span class="text-orange w-[156px] sm:w-[188px] flex-none">{{> logoHorizontal}}</span>
    </a>

    <nav class="hidden xl:flex xl:flex-1 xl:justify-center min-[1400px]:flex-none items-center" aria-label="เมนูหลัก">

      {{!-- เมนูหลักตาม Wireframe v22 (src/data/nav.json) · ชื่อ ลำดับ กลุ่ม ตรง v22 · tests/v22-structure.test.js ตรวจ --}}
      <a class="nav-link{{#if (eq active nav.home.active)}} is-active{{/if}}" href="{{url nav.home.to}}"{{#if (eq active nav.home.active)}} aria-current="page"{{/if}}>{{nav.home.label}}</a>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.products.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaProducts" data-mega-btn>
          {{nav.products.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaProducts" class="dd w-[320px]" hidden data-mega-panel>
          {{#each nav.products.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaProducts-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaProducts-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.uses.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaUse" data-mega-btn>
          {{nav.uses.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaUse" class="dd w-[400px]" hidden data-mega-panel>
          {{#each nav.uses.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaUse-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaUse-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <a class="nav-link{{#if (eq active nav.designs.active)}} is-active{{/if}}" href="{{url nav.designs.to}}"{{#if (eq active nav.designs.active)}} aria-current="page"{{/if}}>{{nav.designs.label}}</a>
      <a class="nav-link{{#if (eq active nav.works.active)}} is-active{{/if}}" href="{{url nav.works.to}}"{{#if (eq active nav.works.active)}} aria-current="page"{{/if}}>{{nav.works.label}}</a>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.learn.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaLearn" data-mega-btn>
          {{nav.learn.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaLearn" class="dd w-[320px]" hidden data-mega-panel>
          {{#each nav.learn.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaLearn-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaLearn-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <a class="nav-link{{#if (eq active nav.about.active)}} is-active{{/if}}" href="{{url nav.about.to}}"{{#if (eq active nav.about.active)}} aria-current="page"{{/if}}>{{nav.about.label}}</a>
    </nav>

    <span class="flex-1 xl:hidden"></span>

    {{> contactBtn active=active cls="hidden sm:inline-flex justify-self-end"}}

    <button class="xl:hidden btn btn-line btn-sm gap-2" type="button" data-menu-open aria-expanded="false" aria-controls="mobileMenu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      เมนู
    </button>
  </div>
</header>

<!-- เมนูมือถือ · เต็มจอ แถวใหญ่ -->
<div id="mobileMenu" data-where="mobile-menu" role="dialog" aria-modal="true" aria-label="เมนู" hidden class="fixed inset-0 z-[100] bg-paper xl:hidden overflow-y-auto">
  <div class="wrap flex items-center gap-4 min-h-[80px] border-b border-line">
    <span class="font-display font-bold text-[25px]">เมนู</span>
    <span class="flex-1"></span>
    {{!-- ค้นหาสินค้า แบบเสื้อ และคำถาม (ลองใช้จริง 30 ต.ค.: หน้าค้นหามีลิงก์แค่ในหน้า 404) · อยู่นอกรายการเมนู v22 --}}
    <a class="btn btn-line btn-sm gap-2" href="{{url 'search'}}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>ค้นหา</a>
    <button class="btn btn-line btn-sm gap-2" type="button" data-menu-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      ปิด
    </button>
  </div>
  {{!-- หมวดย่อยพับด้วย <details> ทุกหน้า (29 ต.ค. อาร์ต: หัวหมวดเดิมเป็นป้ายตัวเล็กสีเทา ดูไม่เหมือนเมนู · หน้าแรกพับด้วยสคริปต์ หน้าอื่นยาวเหยียด) · หมวดของหน้าปัจจุบันเปิดไว้ --}}
  <nav class="wrap pb-32" aria-label="เมนูมือถือ">
    <a class="mnav" href="{{url nav.home.to}}"{{#if (eq active nav.home.active)}} aria-current="page"{{/if}}>{{nav.home.label}}</a>

    <details class="mnav-fold"{{#if (eq active nav.products.active)}} open{{/if}}>
      <summary class="mnav">{{nav.products.label}}</summary>
      <div class="mnav-fold__body">
      {{#each nav.products.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}"{{#if (eq (url this.[1]) @root.articleHref)}} aria-current="page"{{/if}}>{{this.[0]}}</a>{{/each}}{{/each}}
      </div>
    </details>

    <details class="mnav-fold"{{#if (eq active nav.uses.active)}} open{{/if}}>
      <summary class="mnav">{{nav.uses.label}}</summary>
      <div class="mnav-fold__body">
      {{#each nav.uses.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}"{{#if (eq (url this.[1]) @root.articleHref)}} aria-current="page"{{/if}}>{{this.[0]}}</a>{{/each}}{{/each}}
      </div>
    </details>

    <a class="mnav" href="{{url nav.designs.to}}"{{#if (eq (url nav.designs.to) @root.articleHref)}} aria-current="page"{{/if}}>{{nav.designs.label}}</a>
    <a class="mnav" href="{{url nav.works.to}}"{{#if (eq (url nav.works.to) @root.articleHref)}} aria-current="page"{{/if}}>{{nav.works.label}}</a>

    <details class="mnav-fold"{{#if (eq active nav.learn.active)}} open{{/if}}>
      <summary class="mnav">{{nav.learn.label}}</summary>
      <div class="mnav-fold__body">
      {{#each nav.learn.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}"{{#if (eq (url this.[1]) @root.articleHref)}} aria-current="page"{{/if}}>{{this.[0]}}</a>{{/each}}{{/each}}
      </div>
    </details>

    <a class="mnav" href="{{url nav.about.to}}"{{#if (eq (url nav.about.to) @root.articleHref)}} aria-current="page"{{/if}}>{{nav.about.label}}</a>

    {{!-- แผงติดต่อท้ายเมนู (11 พ.ย. 2026 อาร์ต "อันนี้ต่อ ทำมาดีๆหน่อย" · เดิมปุ่ม 3 ทรงไม่เข้าชุด + ลิงก์ลูกค้าเดิมตัวเล็ก)
         LINE ปุ่มหลัก (อาร์ตเคาะ 30 ต.ค.) + บรรทัดสถานะเวลาทำการจริง (nudge.js data-float-status) → โทร | ติดต่อทีมดี การ์ดคู่ทรงเดียวกัน → ลูกค้าเดิม สั่งซ้ำ | ติดตามงาน
         ทุกปุ่มชิดซ้าย ไอคอนเส้นชุดเดียว · หน้าติดต่อ = การ์ดติดต่อพาไปฟอร์ม --}}
    <div class="mct">
      <a class="mct__line" href="{{@root.pageLine}}" data-track="line" data-where="mobile-menu"><span class="mct__lico" aria-hidden="true">{{> icoLine}}</span><span class="mct__lt"><b>ทัก LINE ขอราคา</b><span class="mct__st" data-float-status><span data-float-status-t>ส่งรูปหรือแบบมาคุยได้เลย</span></span></span><svg class="mct__arw" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <div class="mct__two">
        <a class="mct__tile" href="tel:{{site.phonePrimaryTel}}"><svg class="mct__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><span class="mct__tt"><b>โทร</b><span class="tabular-nums">{{site.phonePrimary}}</span></span></a>
        <a class="mct__tile" href="{{#if (eq active 'contact')}}#form" aria-current="page{{else}}{{url 'contact'}}{{/if}}"><svg class="mct__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/></svg><span class="mct__tt"><b>ติดต่อทีมดี</b><span>ฟอร์มและช่องทางอื่น</span></span></a>
      </div>
      <p class="mct__k">ลูกค้าเดิม</p>
      <div class="mct__two">
        <a class="mct__old" href="{{@root.reorderLine}}" data-track="line" data-where="menu-reorder"><svg class="mct__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3L20 9"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 0 1-14 5.3L4 15"/><path d="M4 20v-5h5"/></svg><span>สั่งซ้ำ / เพิ่มจำนวน</span></a>
        <a class="mct__old" href="{{@root.trackLine}}" data-track="line" data-where="menu-track"><svg class="mct__ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg><span>ติดตามงาน</span></a>
      </div>
    </div>
  </nav>
</div>
