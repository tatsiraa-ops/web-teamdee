<a class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:left-2 focus:top-2 focus:bg-orange focus:text-ink focus:px-5 focus:py-3 focus:font-bold" href="#main">ข้ามไปเนื้อหาหลัก</a>

<header class="sticky top-0 z-50 bg-paper border-b border-line relative" data-header>
  <div class="wrap flex items-center gap-2 min-h-[76px]">

    <a class="flex items-center gap-2.5 flex-none min-h-tap mr-2 sm:mr-4 xl:mr-8" href="/" aria-label="TEAMDEE หน้าแรก">
      <span class="text-orange w-[156px] sm:w-[188px] flex-none">{{> logoHorizontal}}</span>
    </a>

    <nav class="hidden xl:flex items-center" aria-label="เมนูหลัก">

      {{!-- สินค้าและบริการ · เมนูเปิดตัวเลือก ไม่มีหน้ารวม (Brief ข้อ 07) · ทรงเสื้อซ้อนใต้เทคนิค (Wireframe v2) --}}
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active 'products')}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaProducts" data-mega-btn>
          สินค้าและบริการ
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaProducts" class="dd w-[380px]" hidden data-mega-panel>
          <p class="dd__group" id="ddh-products">สินค้าตามเทคนิค</p>
          <ul aria-labelledby="ddh-products">
            {{#each productTree}}
            <li>
              <a class="dd__item" href="{{url 'products' this.id}}"><span class="dd__t">{{#if this.navName}}{{this.navName}}{{else}}{{this.menuName}}{{/if}}</span><span class="dd__d">{{this.short}}</span></a>
              {{#if this.children.length}}
              <ul class="dd__sub" aria-label="ทรงเสื้อของ{{this.menuName}}">
                {{#each this.children}}<li><a class="dd__item dd__item--compact" href="{{url 'products' this.id}}"><span class="dd__t">{{this.menuName}}</span></a></li>{{/each}}
              </ul>
              {{/if}}
            </li>
            {{/each}}
          </ul>
          <div class="dd__sep" aria-hidden="true"></div>
          <a class="dd__foot" href="{{url 'designs'}}"><span>ดูแบบเสื้อทั้งหมด</span><span>{{designFilters.total}} แบบ &rarr;</span></a>
        </div>
      </div>

      {{!-- เลือกตามการใช้งาน · มีหน้ารวม (Brief ข้อ 07) --}}
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active 'use')}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaUse" data-mega-btn>
          เลือกตามการใช้งาน
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaUse" class="dd" hidden data-mega-panel>
          <p class="dd__group" id="ddh-use">ทีมของคุณคือแบบไหน</p>
          <ul aria-labelledby="ddh-use">
            {{#each uses}}<li><a class="dd__item" href="{{url 'uses' this.id}}"><span class="dd__t">{{this.name}}</span><span class="dd__d">{{this.short}}</span></a></li>{{/each}}
          </ul>
          <div class="dd__sep" aria-hidden="true"></div>
          <a class="dd__foot" href="{{url 'uses' 'index'}}"><span>ยังไม่แน่ใจ ดูทั้ง 5 กลุ่ม</span><span>&rarr;</span></a>
        </div>
      </div>

      <a class="nav-link{{#if (eq active 'designs')}} is-active{{/if}}" href="{{url 'designs'}}">แบบเสื้อ</a>
      <a class="nav-link{{#if (eq active 'works')}} is-active{{/if}}" href="{{url 'projects'}}">ผลงานและรีวิว</a>

      {{!-- คู่มือและบทความ · เมนู ไม่มีหน้ารวม (Brief ข้อ 07) --}}
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active 'learn')}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaLearn" data-mega-btn>
          คู่มือและบทความ
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaLearn" class="dd w-[340px]" hidden data-mega-panel>
          <p class="dd__group" id="ddh-guides">คู่มือสั่งทำ</p>
          <ul aria-labelledby="ddh-guides">
            {{#each guides}}<li><a class="dd__item dd__item--compact" href="{{url 'guides' this.id}}"><span class="dd__t">{{this.name}}</span></a></li>{{/each}}
            <li><a class="dd__item dd__item--compact" href="{{url 'calculations'}}"><span class="dd__t">ประมาณราคาเบื้องต้น</span></a></li>
          </ul>
          <div class="dd__sep" aria-hidden="true"></div>
          <p class="dd__group" id="ddh-more">อ่านเพิ่ม</p>
          <ul aria-labelledby="ddh-more">
            <li><a class="dd__item" href="{{url 'blog'}}"><span class="dd__t">บทความและไอเดีย</span><span class="dd__d">เลือกเสื้อ ผ้าและเทคนิค ไอเดีย วางแผนสั่ง</span></a></li>
            <li><a class="dd__item" href="{{url 'faq'}}"><span class="dd__t">คำถามที่พบบ่อย</span><span class="dd__d">คำตอบชุดเดียวกับที่ทีมขายใช้ตอบ</span></a></li>
          </ul>
        </div>
      </div>

      <a class="nav-link{{#if (eq active 'about')}} is-active{{/if}}" href="{{url 'about'}}">รู้จักทีมดี</a>
    </nav>

    <span class="flex-1"></span>

    <a class="hidden sm:inline-flex btn btn-orange btn-sm{{#if (eq active 'contact')}} !bg-ink !border-ink !text-paper{{/if}}" href="{{url 'contact'}}">ติดต่อทีมดี</a>

    <button class="xl:hidden btn btn-line btn-sm gap-2" type="button" data-menu-open aria-expanded="false" aria-controls="mobileMenu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      เมนู
    </button>
  </div>
</header>

<!-- เมนูมือถือ · เต็มจอ แถวใหญ่ -->
<div id="mobileMenu" hidden class="fixed inset-0 z-[100] bg-paper xl:hidden overflow-y-auto">
  <div class="wrap flex items-center gap-4 min-h-[80px] border-b border-line">
    <span class="font-display font-bold text-[25px]">เมนู</span>
    <span class="flex-1"></span>
    <button class="btn btn-line btn-sm gap-2" type="button" data-menu-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      ปิด
    </button>
  </div>
  <nav class="wrap pb-32" aria-label="เมนูมือถือ">
    <a class="mnav" href="/">หน้าแรก</a>

    <p class="mnav__head">สินค้าและบริการ</p>
    {{#each productTree}}<a class="mnav mnav--sub" href="{{url 'products' this.id}}">{{#if this.navName}}{{this.navName}}{{else}}{{this.menuName}}{{/if}}</a>{{#each this.children}}<a class="mnav mnav--sub !pl-9 !text-[17px]" href="{{url 'products' this.id}}">{{this.menuName}}</a>{{/each}}{{/each}}

    <p class="mnav__head">เลือกตามการใช้งาน</p>
    <a class="mnav mnav--sub" href="{{url 'uses' 'index'}}">ดูทั้ง 5 กลุ่ม</a>
    {{#each uses}}<a class="mnav mnav--sub" href="{{url 'uses' this.id}}">{{this.name}}</a>{{/each}}

    <a class="mnav" href="{{url 'designs'}}">แบบเสื้อ</a>
    <a class="mnav" href="{{url 'projects'}}">ผลงานและรีวิว</a>

    <p class="mnav__head">คู่มือและบทความ</p>
    {{#each guides}}<a class="mnav mnav--sub" href="{{url 'guides' this.id}}">{{this.name}}</a>{{/each}}
    <a class="mnav mnav--sub" href="{{url 'calculations'}}">ประมาณราคาเบื้องต้น</a>
    <a class="mnav mnav--sub" href="{{url 'blog'}}">บทความและไอเดีย</a>
    <a class="mnav mnav--sub" href="{{url 'faq'}}">คำถามที่พบบ่อย</a>

    <a class="mnav" href="{{url 'about'}}">รู้จักทีมดี</a>

    <div class="grid gap-3 mt-7">
      <a class="btn btn-orange btn-lg w-full" href="{{url 'contact'}}">ติดต่อทีมดี</a>
      <a class="btn btn-line btn-lg w-full" href="{{site.lineUrl}}">ทักไลน์</a>
      <a class="btn btn-line btn-lg w-full tabular-nums" href="tel:{{site.phonePrimaryTel}}">โทร {{site.phonePrimary}}</a>
    </div>
  </nav>
</div>
