<a class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:left-2 focus:top-2 focus:bg-orange focus:text-paper focus:px-5 focus:py-3 focus:font-bold" href="#main">ข้ามไปเนื้อหาหลัก</a>

<header class="sticky top-0 z-50 bg-paper border-b border-line relative" data-header>
  {{!-- เมนูหลักอยู่กลางแถบ (อาร์ต 21 ต.ค. 2026) · จอ 1400+ กลางจอพอดีด้วย grid 3 ช่อง · 1280–1399 ที่ไม่พอ กลางช่องระหว่างโลโก้กับปุ่ม --}}
  <div class="wrap-full flex items-center gap-2 min-h-[76px] min-[1400px]:grid min-[1400px]:grid-cols-[1fr_auto_1fr]">

    <a class="flex items-center gap-2.5 flex-none min-h-tap mr-2 sm:mr-4 xl:mr-8 justify-self-start" href="/" aria-label="TEAMDEE หน้าแรก">
      <span class="text-orange w-[156px] sm:w-[188px] flex-none">{{> logoHorizontal}}</span>
    </a>

    <nav class="hidden xl:flex xl:flex-1 xl:justify-center min-[1400px]:flex-none items-center" aria-label="เมนูหลัก">

      {{!-- เมนูหลักตาม Wireframe v22 (src/data/nav.json) · ชื่อ ลำดับ กลุ่ม ตรง v22 · tests/v22-structure.test.js ตรวจ --}}
      <a class="nav-link{{#if (eq active nav.home.active)}} is-active{{/if}}" href="{{url nav.home.to}}"{{#if (eq active nav.home.active)}} aria-current="page"{{/if}}>{{nav.home.label}}</a>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.products.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaProducts" data-mega-btn>
          {{nav.products.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaProducts" class="dd w-[320px]" hidden data-mega-panel>
          {{#each nav.products.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaProducts-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaProducts-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.uses.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaUse" data-mega-btn>
          {{nav.uses.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaUse" class="dd w-[400px]" hidden data-mega-panel>
          {{#each nav.uses.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaUse-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaUse-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <a class="nav-link{{#if (eq active nav.designs.active)}} is-active{{/if}}" href="{{url nav.designs.to}}"{{#if (eq active nav.designs.active)}} aria-current="page"{{/if}}>{{nav.designs.label}}</a>
      <a class="nav-link{{#if (eq active nav.works.active)}} is-active{{/if}}" href="{{url nav.works.to}}"{{#if (eq active nav.works.active)}} aria-current="page"{{/if}}>{{nav.works.label}}</a>
      <div class="relative" data-mega-root>
        <button class="nav-link nav-link--btn{{#if (eq active nav.learn.active)}} is-active{{/if}}" type="button" aria-expanded="false" aria-controls="megaLearn" data-mega-btn>
          {{nav.learn.label}}
          <svg class="ml-1.5 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-caret><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="megaLearn" class="dd w-[320px]" hidden data-mega-panel>
          {{#each nav.learn.groups}}
          {{#unless this.h}}{{#unless @first}}<div class="dd__sep" aria-hidden="true"></div>{{/unless}}{{/unless}}
          {{#if this.h}}<p class="dd__group" id="megaLearn-{{@index}}">{{this.h}}</p>{{/if}}
          <ul{{#if this.h}} aria-labelledby="megaLearn-{{@index}}"{{/if}}>
            {{#each this.items}}<li><a class="dd__item dd__item--compact" href="{{url this.[1]}}"><span class="dd__t">{{this.[0]}}</span></a></li>{{/each}}
          </ul>
          {{/each}}
        </div>
      </div>
      <a class="nav-link{{#if (eq active nav.about.active)}} is-active{{/if}}" href="{{url nav.about.to}}"{{#if (eq active nav.about.active)}} aria-current="page"{{/if}}>{{nav.about.label}}</a>
    </nav>

    <span class="flex-1 xl:hidden"></span>

    <a class="hidden sm:inline-flex justify-self-end btn btn-orange btn-sm{{#if (eq active 'contact')}} !bg-ink !border-ink !text-paper{{/if}}" href="{{url 'contact'}}">ติดต่อทีมดี</a>

    <button class="xl:hidden btn btn-line btn-sm gap-2" type="button" data-menu-open aria-expanded="false" aria-controls="mobileMenu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      เมนู
    </button>
  </div>
</header>

<!-- เมนูมือถือ · เต็มจอ แถวใหญ่ -->
<div id="mobileMenu" data-where="mobile-menu" role="dialog" aria-modal="true" aria-label="เมนู" hidden class="fixed inset-0 z-[100] bg-paper xl:hidden overflow-y-auto">
  <div class="wrap flex items-center gap-4 min-h-[80px] border-b border-line">
    <span class="font-display font-bold text-[25px]">เมนู</span>
    <span class="flex-1"></span>
    <button class="btn btn-line btn-sm gap-2" type="button" data-menu-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      ปิด
    </button>
  </div>
  <nav class="wrap pb-32" aria-label="เมนูมือถือ">
    <a class="mnav" href="{{url nav.home.to}}"{{#if (eq active nav.home.active)}} aria-current="page"{{/if}}>{{nav.home.label}}</a>

    <p class="mnav__head">{{nav.products.label}}</p>
    {{#each nav.products.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}">{{this.[0]}}</a>{{/each}}{{/each}}

    <p class="mnav__head">{{nav.uses.label}}</p>
    {{#each nav.uses.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}">{{this.[0]}}</a>{{/each}}{{/each}}

    <a class="mnav" href="{{url nav.designs.to}}">{{nav.designs.label}}</a>
    <a class="mnav" href="{{url nav.works.to}}">{{nav.works.label}}</a>

    <p class="mnav__head">{{nav.learn.label}}</p>
    {{#each nav.learn.groups}}{{#if this.h}}<p class="mnav__head mnav__head--sub">{{this.h}}</p>{{/if}}{{#each this.items}}<a class="mnav mnav--sub" href="{{url this.[1]}}">{{this.[0]}}</a>{{/each}}{{/each}}

    <a class="mnav" href="{{url nav.about.to}}">{{nav.about.label}}</a>

    <div class="grid gap-3 mt-7">
      <a class="btn btn-orange btn-lg w-full" href="{{url 'contact'}}">ติดต่อทีมดี</a>
      <a class="btn btn-line btn-lg w-full" href="{{site.lineUrl}}" data-track="line">ทัก LINE ขอราคา</a>
      <a class="btn btn-line btn-lg w-full tabular-nums" href="tel:{{site.phonePrimaryTel}}">โทร {{site.phonePrimary}}</a>
    </div>
  </nav>
</div>
